@model RiderCreateVm
@{ ViewData["Title"] = "Add Rider"; }

<div class="page-header">
    <h1>Add Rider</h1>
    <a href="/Riders" class="btn btn-secondary btn-sm">← Back</a>
</div>

<div class="card" style="max-width:520px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label asp-for="FullName">Full Name *</label>
            <input asp-for="FullName" class="form-control" placeholder="e.g. Adamu Kwara" />
            <span asp-validation-for="FullName" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="LocalPhone">Phone *</label>
            <div class="flex" style="gap:8px;">
                <select asp-for="CountryCode" class="form-control" style="max-width:110px;">
                    <option value="+234">🇳🇬 +234</option>
                    <option value="+1">🇺🇸 +1</option>
                    <option value="+44">🇬🇧 +44</option>
                    <option value="+233">🇬🇭 +233</option>
                    <option value="+254">🇰🇪 +254</option>
                    <option value="+27">🇿🇦 +27</option>
                </select>
                <input asp-for="LocalPhone" class="form-control" placeholder="8012345678" />
            </div>
            <span asp-validation-for="LocalPhone" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="VehicleType">Vehicle Type *</label>
            <select asp-for="VehicleType" class="form-control">
                <option value="Motorcycle">Motorcycle</option>
                <option value="Bicycle">Bicycle</option>
                <option value="Car">Car</option>
                <option value="Van">Van</option>
            </select>
            <span asp-validation-for="VehicleType" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="VehiclePlate">Vehicle Plate</label>
            <input asp-for="VehiclePlate" class="form-control" placeholder="e.g. LND-123-AA" />
        </div>
        <div class="form-group">
            <label asp-for="ProfileImageFile">Profile Photo</label>
            <input asp-for="ProfileImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" data-preview="riderImgPrev" />
            <div style="margin-top:8px"><img id="riderImgPrev" src="" style="display:none;max-width:100px;border-radius:50%;" /></div>
            <small class="text-muted">Max 2 MB. Required before rider can be approved.</small>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create Rider</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

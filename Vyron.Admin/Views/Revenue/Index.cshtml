@{
    ViewData["Title"] = "Revenue Summary";
    var fmt = (decimal d) => d.ToString("N2");
}

<div class="filter-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Apply</button>
    </form>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Orders</div>
        <div class="stat-value">@ViewBag.TotalOrders</div>
        <div class="stat-sub">In period</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Completed</div>
        <div class="stat-value text-success">@ViewBag.CompletedCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pending / Partial</div>
        <div class="stat-value text-warn">@ViewBag.PendingCount</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Cancelled</div>
        <div class="stat-value text-danger">@ViewBag.CancelledCount</div>
    </div>
</div>

<div class="stats-grid" style="margin-top:1rem;">
    <div class="stat-card">
        <div class="stat-label">Total Order Value</div>
        <div class="stat-value">₦@fmt((decimal)ViewBag.TotalOrderValue)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Completed Revenue</div>
        <div class="stat-value text-success">₦@fmt((decimal)ViewBag.CompletedRevenue)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pickup Fees Collected</div>
        <div class="stat-value">₦@fmt((decimal)ViewBag.PickupFeesCollected)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Delivery Fees</div>
        <div class="stat-value">₦@fmt((decimal)ViewBag.DeliveryFees)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Platform Commission (@ViewBag.CommissionPct%)</div>
        <div class="stat-value">₦@fmt((decimal)ViewBag.CommissionEstimate)</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Store Payout Estimate</div>
        <div class="stat-value">₦@fmt((decimal)ViewBag.StorePayoutEstimate)</div>
    </div>
</div>

@if (ViewBag.RecentPayments != null)
{
    <div class="card" style="margin-top:1.5rem;">
        <div class="card-header">Recent Successful Payments</div>
        <div class="card-body p-0">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Order</th>
                        <th>Store</th>
                        <th>Type</th>
                        <th>Method</th>
                        <th class="text-right">Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.RecentPayments)
                    {
                        <tr>
                            <td><code>@p.PaymentRef</code></td>
                            <td>@p.Order?.OrderNumber</td>
                            <td>@p.Order?.Store?.Name</td>
                            <td>@p.Type</td>
                            <td>@p.Method</td>
                            <td class="text-right">₦@((decimal)p.Amount).ToString("N2")</td>
                            <td>@((DateTime)p.CreatedAt).ToString("dd MMM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@using Vyron.API.Models
@model Coupon
@{
    ViewData["Title"] = "Create Coupon";
}

<div class="card" style="max-width:640px;">
    <div class="card-header">New Coupon</div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="form-group">
                <label asp-for="Code">Code <span class="text-danger">*</span></label>
                <input asp-for="Code" class="form-control" placeholder="e.g. VYRON20" style="text-transform:uppercase" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Description</label>
                <input asp-for="Description" class="form-control" placeholder="e.g. 20% off first 3 orders" />
            </div>
            <div class="form-group">
                <label asp-for="DiscountType">Discount Type <span class="text-danger">*</span></label>
                <select asp-for="DiscountType" class="form-control">
                    <option value="Percent">Percent (%)</option>
                    <option value="Fixed">Fixed Amount (₦)</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="DiscountValue">Discount Value <span class="text-danger">*</span></label>
                <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 20" />
            </div>
            <div class="form-group">
                <label asp-for="MaxUsesPerCustomer">Max Uses Per Customer</label>
                <input asp-for="MaxUsesPerCustomer" type="number" min="1" class="form-control" placeholder="Leave blank = unlimited" />
            </div>
            <div class="form-group">
                <label asp-for="GlobalMaxUses">Global Max Uses</label>
                <input asp-for="GlobalMaxUses" type="number" min="1" class="form-control" placeholder="Leave blank = unlimited" />
            </div>
            <div class="form-group">
                <label asp-for="AppliesToFirstNOrders">Applies To First N Orders (per customer)</label>
                <input asp-for="AppliesToFirstNOrders" type="number" min="1" class="form-control" placeholder="e.g. 3 = valid on first 3 orders only" />
            </div>
            <div class="form-group">
                <label asp-for="StartDate">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="EndDate">End Date (Expiry)</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsActive" type="checkbox" /> Active
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create</button>
                <a href="/Coupons" class="btn btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

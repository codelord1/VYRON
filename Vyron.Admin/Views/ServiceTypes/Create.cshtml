@model ServiceTypeEntity
@{ ViewData["Title"] = "New Service Type"; }

<div class="page-header">
    <h1>New Service Type</h1>
    <a href="/ServiceTypes" class="btn btn-ghost">← Back</a>
</div>

<div class="service-form-card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.SelectMany(s => s.Value!.Errors))
                { <div>@err.ErrorMessage</div> }
            </div>
        }

        <div class="form-group">
            <label asp-for="Name">Name <span style="color:red">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Premium Wash" required />
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="Brief description of this service type"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="SortOrder">Display Order</label>
            <input asp-for="SortOrder" type="number" class="form-control" min="0" />
            <small class="text-muted">Lower numbers appear first in dropdowns.</small>
        </div>
        <div class="form-group" style="display:flex;align-items:center;gap:10px;">
            <input asp-for="IsActive" type="checkbox" style="width:18px;height:18px;" />
            <label asp-for="IsActive" style="margin:0;font-weight:400;">Active (visible to store owners)</label>
        </div>
        <div class="form-actions" style="display:flex;gap:10px;margin-top:20px;">
            <button type="submit" class="btn btn-primary">Create Service Type</button>
            <a href="/ServiceTypes" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@model List<Order>
@{ ViewData["Title"] = "Orders"; var status = (OrderStatus?)ViewBag.Status; var search = (string?)ViewBag.Search; }

<div class="page-header">
    <h1>Orders</h1>
    <span class="text-muted">@ViewBag.Total total</span>
</div>

<form class="filters" method="get">
    <div class="form-group">
        <label>Search</label>
        <input type="text" name="search" value="@search" placeholder="Order #, customer, store" />
    </div>
    <div class="form-group">
        <label>Status</label>
        <select name="status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(status == s)">@s</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/Orders" class="btn btn-secondary btn-sm">Reset</a>
</form>

<div class="table-wrap">
    <table class="table-mobile-card">
        <thead>
            <tr><th>Order #</th><th>Customer</th><th>Store</th><th>Service</th><th>Status</th><th>Total</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted" style="padding: 30px;">No orders found.</td></tr>
            }
            @foreach (var o in Model)
            {
                <tr>
                    <td><a href="/Orders/Detail/@o.Id" class="text-bold">@o.OrderNumber</a></td>
                    <td>@o.Customer.FullName<br /><small class="text-muted">@o.Customer.Phone</small></td>
                    <td>@o.Store.Name</td>
                    <td>@o.Service.Name</td>
                    <td><span class="badge badge-@StatusBadge(o.Status)">@o.Status</span></td>
                    <td class="text-bold">₦@((o.ActualTotal > 0 ? o.ActualTotal : o.TotalEstimate).ToString("N0"))</td>
                    <td><small>@o.CreatedAt.ToString("MMM dd HH:mm")</small></td>
                    <td><a href="/Orders/Detail/@o.Id" class="btn btn-secondary btn-sm">View →</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ var page = (int)ViewBag.Page; var hasNext = Model.Count == 25; }
<div class="pagination">
    @if (page > 1) { <a href="?status=@status&search=@search&page=@(page-1)">← Prev</a> }
    <span class="active">Page @(page)</span>
    @if (hasNext) { <a href="?status=@status&search=@search&page=@(page+1)">Next →</a> }
</div>

@functions {
    string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Confirmed or OrderStatus.PickupFeePaid or OrderStatus.RiderAssigned => "info",
        OrderStatus.PickedUp or OrderStatus.OutForDelivery => "purple",
        OrderStatus.Processing => "warning",
        OrderStatus.Ready or OrderStatus.Delivered or OrderStatus.BalancePaid or OrderStatus.Completed => "success",
        OrderStatus.Disputed => "danger",
        _ => "gray"
    };
}

@using Vyron.Shared.Enums
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071416" />
    <title>@ViewData["Title"] - VYRON Manager</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <meta name="idle-timeout" content="@(ViewBag.IdleTimeoutMinutes ?? 15)" />
</head>
<body>
@{
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var isOwner = User.IsInRole("StoreOwner");
    var ctrl = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    var action = (string?)ViewContext.RouteData.Values["action"] ?? "";
    var displayName = User.Identity?.Name ?? "VYRON User";
    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(initials)) { initials = "V"; }
    var subtitle = (string?)ViewData["Subtitle"];
    string ActiveIf(string controller, params string[] actions)
    {
        var controllerMatch = string.Equals(ctrl, controller, StringComparison.OrdinalIgnoreCase);
        if (!controllerMatch) return "";
        if (actions.Length == 0) return "active";
        return actions.Contains(action, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    }
}

<div class="app-shell">
    <aside class="sidebar" aria-label="Primary navigation">
        <div class="sidebar-header">
            <div class="brand"><span>VY</span>RON</div>
            <button class="sidebar-mini-toggle" type="button" aria-label="Toggle menu">☰</button>
            <div class="role">@(isAdmin ? "Admin Console" : isOwner ? "Store Console" : "Console")</div>
        </div>

        <nav class="sidebar-nav">
            @if (isAdmin)
            {
                <div class="nav-section">Operations</div>
                <a href="/Home" class="@ActiveIf("Home")"><span class="nav-icon">▦</span><span>Dashboard</span></a>
                <a href="/Orders" class="@ActiveIf("Orders")"><span class="nav-icon">◧</span><span>Orders</span></a>
                <a href="/Stores" class="@ActiveIf("Stores")"><span class="nav-icon">▣</span><span>Stores</span></a>
                <a href="/Riders" class="@ActiveIf("Riders")"><span class="nav-icon">◌</span><span>Riders</span></a>
                <a href="/Services" class="@ActiveIf("Services")"><span class="nav-icon">◇</span><span>Services</span></a>
                <a href="/ServiceTypes" class="@ActiveIf("ServiceTypes")"><span class="nav-icon">◈</span><span>Service Types</span></a>
                <div class="nav-section">Finance &amp; Trust</div>
                <a href="/Payments" class="@ActiveIf("Payments")"><span class="nav-icon">▰</span><span>Payments</span></a>
                <a href="/Revenue" class="@ActiveIf("Revenue")"><span class="nav-icon">₦</span><span>Revenue</span></a>
                <a href="/Coupons" class="@ActiveIf("Coupons")"><span class="nav-icon">%</span><span>Coupons</span></a>
                <a href="/Disputes" class="@ActiveIf("Disputes")"><span class="nav-icon">△</span><span>Disputes</span></a>
                <a href="/Reviews" class="@ActiveIf("Reviews")"><span class="nav-icon">★</span><span>Reviews</span></a>
                <div class="nav-section">Approvals</div>
                <a href="/Riders/Pending" class="@ActiveIf("Riders", "Pending")"><span class="nav-icon">✓</span><span>Rider Approvals</span></a>
                <a href="/StoreOwnerApprovals" class="@ActiveIf("StoreOwnerApprovals")"><span class="nav-icon">◫</span><span>Owner Approvals</span></a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <a href="/AdminUsers" class="@ActiveIf("AdminUsers")"><span class="nav-icon">◆</span><span>Admin Users</span></a>
                }
                <div class="nav-section">People</div>
                <a href="/Users" class="@ActiveIf("Users")"><span class="nav-icon">◉</span><span>Users</span></a>
                <a href="/StoreStaff" class="@ActiveIf("StoreStaff")"><span class="nav-icon">◑</span><span>Store Staff</span></a>
                <a href="/CommunicationLogs" class="@ActiveIf("CommunicationLogs")"><span class="nav-icon">✉</span><span>Messages</span></a>
                <div class="nav-section">Compliance</div>
                <a href="/AuditLogs" class="@ActiveIf("AuditLogs")"><span class="nav-icon">◕</span><span>Audit Logs</span></a>
                <a href="/ActivityLogs" class="@ActiveIf("ActivityLogs")"><span class="nav-icon">◔</span><span>Activity Logs</span></a>
                <a href="/Reports" class="@ActiveIf("Reports")"><span class="nav-icon">◈</span><span>Reports</span></a>
                <div class="nav-section">System</div>
                <a href="/Settings" class="@ActiveIf("Settings")"><span class="nav-icon">⚙</span><span>Settings</span></a>
            }
            else if (isOwner)
            {
                <div class="nav-section">Operations</div>
                <a href="/StoreOwner/Dashboard" class="@ActiveIf("StoreOwner", "Dashboard")"><span class="nav-icon">▦</span><span>Dashboard</span></a>
                <a href="/StoreOwner/Orders" class="@ActiveIf("StoreOwner", "Orders", "OrderDetail")"><span class="nav-icon">◧</span><span>My Orders</span></a>
                <a href="/StoreOwner/Stores" class="@ActiveIf("StoreOwner", "Stores", "StoreCreate", "StoreEdit")"><span class="nav-icon">▣</span><span>My Stores</span></a>
                <a href="/StoreOwner/ServiceOfferings" class="@ActiveIf("StoreOwner", "ServiceOfferings", "ServiceCreate", "ServiceEdit")"><span class="nav-icon">◇</span><span>Services</span></a>
                <a href="/StoreStaff" class="@ActiveIf("StoreStaff")"><span class="nav-icon">◑</span><span>My Staff</span></a>
                <div class="nav-section">Finance &amp; Trust</div>
                <a href="/StoreOwner/Disputes" class="@ActiveIf("StoreOwner", "Disputes", "DisputeDetail")"><span class="nav-icon">△</span><span>Disputes</span></a>
                <a href="/StoreOwner/Reviews" class="@ActiveIf("StoreOwner", "Reviews")"><span class="nav-icon">★</span><span>Reviews</span></a>
            }
        </nav>

        <div class="sidebar-actions">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost btn-block">Log out</button>
            </form>
        </div>

        <a class="sidebar-user" href="/Account/Profile">
            <span class="avatar">@initials</span>
            <span>
                <strong>@displayName</strong>
                <small>@(isAdmin ? "Administrator" : "Store Owner")</small>
            </span>
            <span class="sidebar-user-caret">⌄</span>
        </a>
    </aside>

    <div class="sidebar-backdrop" aria-hidden="true"></div>

    <main class="main-shell">
        <header class="topbar">
            <div class="topbar-left">
                <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
                <div class="topbar-heading">
                    <h1 class="page-title">@(ViewData["Title"] ?? "Dashboard")</h1>
                    @if (!string.IsNullOrWhiteSpace(subtitle))
                    {
                        <p>@subtitle</p>
                    }
                </div>
            </div>

            <div class="topbar-actions">
                <span class="topbar-date">@DateTime.Now.ToString("ddd, MMM dd yyyy")</span>

                @* Notification icon — links to Activity Logs for a real trail *@
                <a href="@(isAdmin ? "/ActivityLogs" : "/StoreOwner/Orders")"
                   class="icon-button topbar-notif" title="Notifications / Activity" aria-label="Notifications">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9" />
                    </svg>
                </a>

                @* Profile dropdown *@
                <div class="profile-drop-wrap" id="profileDropWrap">
                    <button class="user-chip" type="button" id="profileDropBtn"
                            aria-haspopup="true" aria-expanded="false" aria-controls="profileDropMenu">
                        <span class="chip-avatar">@(initials.Length > 0 ? initials[0].ToString() : "V")</span>
                        <span class="chip-name">@displayName</span>
                        <span class="chip-caret" aria-hidden="true">&#8964;</span>
                    </button>
                    <div class="profile-drop-menu" id="profileDropMenu" role="menu" aria-labelledby="profileDropBtn" hidden>
                        <div class="profile-drop-header">
                            <span class="drop-avatar">@initials</span>
                            <div class="drop-info">
                                <strong>@displayName</strong>
                                <small>@(User.IsInRole("SuperAdmin") ? "Super Admin" : isAdmin ? "Administrator" : "Store Owner")</small>
                            </div>
                        </div>
                        <div class="profile-drop-divider"></div>
                        <a href="/Account/Profile" class="profile-drop-item" role="menuitem">
                            <span class="drop-item-icon" aria-hidden="true">&#128100;</span> Profile
                        </a>
                        <a href="/Account/ChangePassword" class="profile-drop-item" role="menuitem">
                            <span class="drop-item-icon" aria-hidden="true">&#128274;</span> Change Password
                        </a>
                        <div class="profile-drop-divider"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:contents;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="profile-drop-item profile-drop-logout" role="menuitem">
                                <span class="drop-item-icon" aria-hidden="true">&#8263;</span> Log Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <section class="content">
            @if (TempData["Success"] is string s) { <div class="alert alert-success">@s</div> }
            @if (TempData["Error"] is string e) { <div class="alert alert-danger">@e</div> }

            @RenderBody()
        </section>
    </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
// ── Profile dropdown ──────────────────────────────────────────────
(function () {
    var btn  = document.getElementById('profileDropBtn');
    var menu = document.getElementById('profileDropMenu');
    var wrap = document.getElementById('profileDropWrap');
    if (!btn || !menu) return;

    function open()  { menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); }
    function close() { menu.hidden = true;  btn.setAttribute('aria-expanded', 'false'); }
    function toggle(){ menu.hidden ? open() : close(); }

    btn.addEventListener('click', function (e) { e.stopPropagation(); toggle(); });

    // Close when clicking outside the dropdown wrap
    document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) close();
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
    });
})();
</script>
</body>
</html>

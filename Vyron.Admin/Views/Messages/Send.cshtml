@{
    ViewData["Title"] = "Send Message";
}

<div class="page-header">
    <h1>Send Message</h1>
    <a href="/CommunicationLogs" class="btn btn-ghost">← Message Logs</a>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"]   is string err){ <div class="alert alert-danger">@err</div> }

<div class="service-form-card" style="max-width:640px;">
    <form method="post" action="/Messages/Send">
        @Html.AntiForgeryToken()

        <!-- Hidden context -->
        <input type="hidden" name="recipientUserId"  value="@ViewBag.UserId" />
        <input type="hidden" name="relatedOrderId"   value="@ViewBag.OrderId" />
        <input type="hidden" name="relatedDisputeId" value="@ViewBag.DisputeId" />

        @if (ViewBag.UserId != null)
        {
            <div style="background:var(--gray-1);border-radius:10px;padding:14px 16px;margin-bottom:20px;font-size:13px;">
                <strong>Recipient:</strong> @ViewBag.RecipientName (@ViewBag.RecipientPhone)
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Recipient Name</label>
                <input type="text" name="recipientName" class="form-control" placeholder="Full name" />
            </div>
            <div class="form-group">
                <label>Recipient Phone</label>
                <input type="text" name="recipientPhone" class="form-control" placeholder="+234..." />
            </div>
        }

        <div class="form-group">
            <label>Channel <span style="color:red">*</span></label>
            <select name="channel" class="form-control" required>
                <option value="InApp">InApp (in-app notification)</option>
                <option value="SMS">SMS (log-only if not configured)</option>
                <option value="Email">Email (log-only if not configured)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Subject <span style="color:red">*</span></label>
            <input type="text" name="subject" class="form-control" placeholder="Message subject" required />
        </div>
        <div class="form-group">
            <label>Body <span style="color:red">*</span></label>
            <textarea name="body" class="form-control" rows="6" placeholder="Message content…" required></textarea>
        </div>
        <div class="form-actions" style="display:flex;gap:10px;margin-top:20px;">
            <button type="submit" class="btn btn-primary">Send Message</button>
            <a href="/CommunicationLogs" class="btn btn-ghost">Cancel</a>
        </div>

        <p style="font-size:12px;color:var(--gray-3);margin-top:14px;">
            💡 SMS and Email channels are logged immediately. Actual delivery depends on provider configuration.
        </p>
    </form>
</div>

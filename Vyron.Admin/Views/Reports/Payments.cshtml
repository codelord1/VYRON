@using Vyron.API.Models
@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Payment Report";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.Total ?? 0;
    const int size = 25;
    int pages = (int)Math.Ceiling(total / (double)size);
}

<div class="filter-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Reports/Payments" class="btn btn-ghost">Clear</a>
    </form>
    <span class="badge">@total payments</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th class="text-right">Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><code>@p.PaymentRef</code></td>
                        <td>@p.Order?.OrderNumber</td>
                        <td>@p.Order?.Customer?.FullName</td>
                        <td>@p.Type</td>
                        <td>@p.Method</td>
                        <td>@(p.IsSuccessful ? "<span class='badge badge-success'>Paid</span>" : "<span class='badge badge-warn'>Pending</span>")</td>
                        <td class="text-right">₦@p.Amount.ToString("N2")</td>
                        <td>@p.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center muted">No payments found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= pages; i++)
        {
            <a href="?from=@ViewBag.From&to=@ViewBag.To&page=@i"
               class="page-btn @(i == page ? "active" : "")">@i</a>
        }
    </div>
}

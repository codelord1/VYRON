@using Vyron.API.Models
@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "Audit Log Report";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.Total ?? 0;
    const int size = 25;
    int pages = (int)Math.Ceiling(total / (double)size);
}

<div class="filter-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="filter-group">
            <label>Search</label>
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Action / entity / user…" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Reports/AuditLogs" class="btn btn-ghost">Clear</a>
    </form>
    <span class="badge">@total entries</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="data-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.CreatedAt.ToString("dd MMM HH:mm")</td>
                        <td>@(a.User?.FullName ?? "—")</td>
                        <td>@a.Action</td>
                        <td>@a.Entity</td>
                        <td><code class="small">@a.EntityId</code></td>
                        <td>@a.IpAddress</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center muted">No audit logs found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= pages; i++)
        {
            <a href="?from=@ViewBag.From&to=@ViewBag.To&search=@ViewBag.Search&page=@i"
               class="page-btn @(i == page ? "active" : "")">@i</a>
        }
    </div>
}

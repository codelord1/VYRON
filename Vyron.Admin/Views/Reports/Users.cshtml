@using Vyron.API.Models
@model IEnumerable<User>
@{
    ViewData["Title"] = "User Report";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.Total ?? 0;
    const int size = 25;
    int pages = (int)Math.Ceiling(total / (double)size);
}

<div class="filter-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="filter-group">
            <label>Role</label>
            <select name="role" class="form-control">
                <option value="">All</option>
                <option value="Customer" selected="@(ViewBag.Role == "Customer")">Customer</option>
                <option value="StoreOwner" selected="@(ViewBag.Role == "StoreOwner")">Store Owner</option>
                <option value="Rider" selected="@(ViewBag.Role == "Rider")">Rider</option>
                <option value="Admin" selected="@(ViewBag.Role == "Admin")">Admin</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Reports/Users" class="btn btn-ghost">Clear</a>
    </form>
    <span class="badge">@total users</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Phone</td>
                        <td>@u.Email</td>
                        <td><span class="badge">@u.Role</span></td>
                        <td>@(u.IsActive ? "Active" : "Inactive")</td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center muted">No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= pages; i++)
        {
            <a href="?from=@ViewBag.From&to=@ViewBag.To&role=@ViewBag.Role&page=@i"
               class="page-btn @(i == page ? "active" : "")">@i</a>
        }
    </div>
}

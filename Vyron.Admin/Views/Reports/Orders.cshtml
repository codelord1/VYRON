@using Vyron.API.Models
@using Vyron.Shared.Enums
@model IEnumerable<Order>
@{
    ViewData["Title"] = "Order Report";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.Total ?? 0;
    const int size = 25;
    int pages = (int)Math.Ceiling(total / (double)size);
}

<div class="filter-bar">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>From</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" />
        </div>
        <div class="filter-group">
            <label>To</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" />
        </div>
        <div class="filter-group">
            <label>Status</label>
            <select name="status" class="form-control">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<OrderStatus>())
                {
                    <option value="@((int)s)" selected="@(ViewBag.Status?.ToString() == ((int)s).ToString())">@s</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Store</label>
            <select name="storeId" class="form-control">
                <option value="">All stores</option>
                @if (ViewBag.Stores != null)
                {
                    foreach (var st in ViewBag.Stores)
                    {
                        <option value="@st.Id" selected="@(ViewBag.StoreId?.ToString() == st.Id.ToString())">@st.Name</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/Reports/Orders" class="btn btn-ghost">Clear</a>
    </form>
    <span class="badge">@total orders</span>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Store</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th class="text-right">Total</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><a href="/Orders/Detail/@o.Id">@o.OrderNumber</a></td>
                        <td>@o.Customer?.FullName</td>
                        <td>@o.Store?.Name</td>
                        <td><span class="badge">@o.Status</span></td>
                        <td>@o.PaymentState</td>
                        <td class="text-right">₦@((o.ActualTotal > 0 ? o.ActualTotal : o.TotalEstimate).ToString("N2"))</td>
                        <td>@o.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center muted">No orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (pages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= pages; i++)
        {
            <a href="?from=@ViewBag.From&to=@ViewBag.To&status=@ViewBag.Status&storeId=@ViewBag.StoreId&page=@i"
               class="page-btn @(i == page ? "active" : "")">@i</a>
        }
    </div>
}

@model ForgotPasswordVm
@{ ViewData["Title"] = "Forgot Password"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password · VYRON Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">VYRON</div>
        <div class="login-tag">Password Reset</div>

        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

        @if (ViewData["EmailSent"] is true)
        {
            <div class="alert alert-success">
                If an account exists with that email or phone, a reset link has been sent.
            </div>
            @if (ViewData["DevResetLink"] is string devLink && !string.IsNullOrEmpty(devLink))
            {
                <div class="alert alert-info" style="word-break:break-all;font-size:12px">
                    <strong>DEV ONLY — Reset link:</strong><br />
                    <a href="@devLink">@devLink</a>
                </div>
            }
            <a href="/Account/Login" class="btn btn-primary btn-block" style="margin-top:14px">Back to Login</a>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>
                <div class="form-group">
                    <label asp-for="Identifier">Email or Phone</label>
                    <input asp-for="Identifier" class="form-control" placeholder="admin@vyron.com or +2348000000000" />
                    <span asp-validation-for="Identifier" class="text-red" style="font-size:11px"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px">Send Reset Link</button>
                <div style="text-align:center;margin-top:12px">
                    <a href="/Account/Login" style="font-size:12px;color:var(--gray-3)">Back to Login</a>
                </div>
            </form>
        }
    </div>
</div>
<script src="~/js/admin.js" asp-append-version="true"></script>
</body>
</html>

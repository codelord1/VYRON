@model ChangePasswordVm
@{ ViewData["Title"] = "Change Password"; Layout = "_Layout"; }

<div class="page-header">
    <h1>Change Password</h1>
    <a href="/Account/Profile" class="btn btn-secondary btn-sm">← Back to Profile</a>
</div>

<div class="card" style="max-width:440px">
    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="form-group">
            <label asp-for="CurrentPassword">Current Password *</label>
            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword">New Password *</label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirm New Password *</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-red" style="font-size:11px"></span>
        </div>
        <div style="margin-top:18px">
            <button type="submit" class="btn btn-primary">Change Password</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

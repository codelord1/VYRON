@model ResetPasswordVm
@{ ViewData["Title"] = "Reset Password"; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password · VYRON Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">VYRON</div>
        <div class="login-tag">Set New Password</div>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="form-group">
                <label asp-for="NewPassword">New Password *</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-red" style="font-size:11px"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password *</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-red" style="font-size:11px"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px">Reset Password</button>
        </form>
    </div>
</div>
<script src="~/js/admin.js" asp-append-version="true"></script>
</body>
</html>

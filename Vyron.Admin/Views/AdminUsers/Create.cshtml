@model Vyron.Admin.Models.AdminUserCreateVm
@{ ViewData["Title"] = "Create Admin User"; }

<div class="page-header">
    <h1>Create Admin User</h1>
    <a href="/AdminUsers" class="btn btn-ghost btn-sm">← Back</a>
</div>

<div class="card" style="max-width:540px">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <asp-validation-summary asp-validation-summary="ModelOnly" class="alert alert-danger" />

        <div class="form-group">
            <label asp-for="FullName">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="John Doe" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Phone">Phone</label>
            <input asp-for="Phone" class="form-control" placeholder="+2348012345678" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email">Email (optional)</label>
            <input asp-for="Email" type="email" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Role</label>
            <div class="radio-group">
                <label><input asp-for="IsAdminUser" type="radio" value="true" /> <strong>AdminUser</strong> — limited admin (cannot manage other admins)</label><br />
                <label><input asp-for="IsAdminUser" type="radio" value="false" /> <strong>Admin</strong> — full platform administrator</label>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Admin User</button>
            <a href="/AdminUsers" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>

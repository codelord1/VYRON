@model LaundryStore
@{ ViewData["Title"] = Model.Name; }

<div class="page-header">
    <h1>@Model.Name</h1>
    <div class="flex" style="gap:8px">
        <a href="/Stores/Edit/@Model.Id" class="btn btn-secondary btn-sm">Edit</a>
        <a href="/Stores" class="btn btn-secondary btn-sm">← Back</a>
    </div>
</div>

@if (Model.Status == StoreStatus.Pending)
{
    <div class="card" style="max-width:600px;border-left:4px solid var(--amber);">
        <h3 class="card-title" style="color:var(--amber)">Pending Approval</h3>
        @if (TempData["ApproveError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        <p style="font-size:13px;color:var(--gray-4)">Approving will set this store to Active and notify the owner. Requirements: at least one store image, phone number, and address must be set.</p>
        <form asp-action="Approve" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-primary btn-sm">Approve Store</button>
        </form>
    </div>
}

<div class="grid-2">
    <div>
        <div class="card">
            <h3 class="card-title">Information</h3>
            <p>@Model.Description</p>
            <hr style="border:none;border-top:1px solid var(--gray-2);margin:10px 0;" />
            <div class="flex-between mb-1"><span>📞 Phone</span><span class="text-bold">@Model.Phone</span></div>
            <div class="flex-between mb-1"><span>📧 Email</span><span class="text-bold">@Model.Email</span></div>
            <div class="flex-between mb-1"><span>📍 Address</span><span>@Model.Address, @Model.Area</span></div>
            <div class="flex-between mb-1"><span>🕐 Hours</span><span>@Model.OpeningHours</span></div>
            <div class="flex-between mb-1"><span>👤 Owner</span><span>@Model.Owner.FullName</span></div>
            <hr style="border:none;border-top:1px solid var(--gray-2);margin:10px 0;" />
            <div class="flex-between mb-1"><span>Pickup fee</span><span class="text-bold">₦@Model.PickupFee.ToString("N0")</span></div>
            <div class="flex-between mb-1"><span>Delivery fee</span><span class="text-bold">₦@Model.DeliveryFee.ToString("N0")</span></div>
            <div class="flex-between mb-1"><span>Pickup time</span><span>~@Model.EstimatedPickupMinutes min</span></div>
        </div>

        <div class="card">
            <h3 class="card-title">Service Offerings (@Model.Services.Count)</h3>
            @foreach (var svc in Model.Services)
            {
                <div class="flex-between" style="padding:8px 0;border-bottom:1px solid var(--gray-2);">
                    <div>
                        <div class="text-bold">@svc.Name</div>
                        <small class="text-muted">@svc.PricingMode · Min ₦@svc.MinimumCharge · ~@svc.EstimatedHours h</small>
                    </div>
                    <div class="text-bold">₦@svc.BasePrice / @(svc.PricingMode == PricingMode.PerKg ? "kg" : "item")</div>
                </div>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <h3 class="card-title">Status &amp; Badges</h3>
            <div class="flex-between mb-2">
                <span>Current status</span>
                <span class="badge badge-@StatusBadge(Model.Status)">@Model.Status</span>
            </div>

            <form asp-action="UpdateStatus" method="post" class="mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="flex gap-2">
                    <select name="status" class="flex-1">
                        @foreach (var s in Enum.GetValues<StoreStatus>())
                        { <option value="@s" selected="@(Model.Status == s)">@s</option> }
                    </select>
                    <button class="btn btn-primary btn-sm">Update</button>
                </div>
            </form>

            <hr style="border:none;border-top:1px solid var(--gray-2);margin:12px 0;" />

            <form asp-action="ToggleVerified" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-@(Model.IsVerified ? "success" : "secondary") btn-sm">
                    @(Model.IsVerified ? "✓ Verified" : "Mark Verified")
                </button>
            </form>
            <form asp-action="ToggleTopRated" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-@(Model.IsTopRated ? "warning" : "secondary") btn-sm">
                    @(Model.IsTopRated ? "⭐ Top Rated" : "Mark Top Rated")
                </button>
            </form>
        </div>

        <div class="card">
            <h3 class="card-title">Performance</h3>
            <div class="flex-between mb-1"><span>Average rating</span><span class="text-bold">⭐ @Model.AverageRating</span></div>
            <div class="flex-between mb-1"><span>Total reviews</span><span class="text-bold">@Model.TotalReviews</span></div>
            <div class="flex-between mb-1"><span>Total orders</span><span class="text-bold">@Model.TotalOrders</span></div>
        </div>

        <div class="card">
            <h3 class="card-title">Store Images</h3>
            @{
                var images = (ViewBag.Images as List<StoreImage>) ?? new List<StoreImage>();
            }
            @if (images.Any())
            {
                <div class="flex" style="flex-wrap:wrap;gap:10px;margin-bottom:14px;">
                    @foreach (var img in images)
                    {
                        <div style="position:relative;text-align:center;">
                            <img src="@img.ImagePath" alt="Store image" style="width:110px;height:90px;object-fit:cover;border-radius:6px;border:2px solid @(img.IsPrimary ? "var(--primary)" : "var(--gray-2)");" />
                            @if (img.IsPrimary)
                            {
                                <div style="font-size:10px;color:var(--primary);font-weight:700;">Primary</div>
                            }
                            <div class="flex" style="gap:4px;justify-content:center;margin-top:4px;">
                                @if (!img.IsPrimary)
                                {
                                    <form asp-action="SetPrimaryImage" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="imageId" value="@img.Id" />
                                        <input type="hidden" name="storeId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-secondary btn-sm" style="font-size:10px;padding:2px 6px;">Set Primary</button>
                                    </form>
                                }
                                <form asp-action="DeleteImage" method="post" onsubmit="return confirm('Delete this image?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <input type="hidden" name="storeId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" style="font-size:10px;padding:2px 6px;">✕</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted" style="font-size:13px;">No images yet. Upload at least one before approving.</p>
            }
            <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="storeId" value="@Model.Id" />
                @if (TempData["ImageError"] is string imgErr) { <div class="alert alert-danger">@imgErr</div> }
                @if (TempData["ImageSuccess"] is string imgOk) { <div class="alert alert-success">@imgOk</div> }
                <div class="flex" style="gap:8px;align-items:center;">
                    <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" style="flex:1;" data-preview="storeImgPrev" />
                    <button type="submit" class="btn btn-primary btn-sm">Upload</button>
                </div>
                <div style="margin-top:6px"><img id="storeImgPrev" src="" style="display:none;max-width:120px;border-radius:6px;" /></div>
                <small class="text-muted">Max 2 MB · JPG, PNG, WebP</small>
            </form>
        </div>

        <div class="card">
            <h3 class="card-title">Recent Reviews</h3>
            @if (!Model.Reviews.Any())
            {
                <p class="text-muted">No reviews yet.</p>
            }
            else
            {
                foreach (var r in Model.Reviews.OrderByDescending(x => x.CreatedAt).Take(5))
                {
                    <div style="padding:8px 0;border-bottom:1px solid var(--gray-2);">
                        <div class="flex-between">
                            <span class="text-bold">@r.Customer.FullName</span>
                            <span style="color:var(--amber);">@(new string('★', r.Rating))</span>
                        </div>
                        <small class="text-muted">@r.CreatedAt.ToString("MMM dd")</small>
                        @if (!string.IsNullOrEmpty(r.Comment))
                        {
                            <p style="margin: 4px 0 0;font-size: 12px;">@r.Comment</p>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@functions {
    string StatusBadge(StoreStatus s) => s switch
    {
        StoreStatus.Active => "success",
        StoreStatus.Pending => "warning",
        StoreStatus.Suspended => "danger",
        _ => "gray"
    };
}

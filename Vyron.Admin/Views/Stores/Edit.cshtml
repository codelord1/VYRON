@model StoreEditVm
@{ ViewData["Title"] = "Edit Store"; }

<div class="page-header">
    <h1>Edit Store</h1>
    <a href="/Stores/Detail/@Model.Id" class="btn btn-secondary btn-sm">← Back</a>
</div>

<div class="card" style="max-width:720px">
    <form asp-action="Edit" enctype="multipart/form-data" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="form-group">
            <label asp-for="Name">Store Name *</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="flex" style="gap:14px">
            <div class="form-group flex-1">
                <label asp-for="Phone">Contact Phone *</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-red" style="font-size:11px"></span>
            </div>
            <div class="form-group flex-1">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Address">Address *</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-red" style="font-size:11px"></span>
        </div>
        <div class="flex" style="gap:14px">
            <div class="form-group flex-1">
                <label asp-for="Area">Area *</label>
                <input asp-for="Area" class="form-control" />
            </div>
            <div class="form-group flex-1">
                <label asp-for="City">City</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="form-group flex-1">
                <label asp-for="State">State</label>
                <input asp-for="State" class="form-control" />
            </div>
        </div>
        <div class="flex" style="gap:14px">
            <div class="form-group flex-1">
                <label asp-for="PickupFee">Pickup Fee (₦)</label>
                <input asp-for="PickupFee" type="number" step="0.01" class="form-control" />
            </div>
            <div class="form-group flex-1">
                <label asp-for="DeliveryFee">Delivery Fee (₦)</label>
                <input asp-for="DeliveryFee" type="number" step="0.01" class="form-control" />
            </div>
        </div>
        <div class="form-group">
            <label asp-for="OpeningHours">Opening Hours</label>
            <input asp-for="OpeningHours" class="form-control" />
        </div>
        <div class="form-group">
            <label>Add Image</label>
            @if (!string.IsNullOrEmpty(Model.CurrentLogoUrl))
            {
                <div style="margin-bottom:8px"><img src="@Model.CurrentLogoUrl" style="max-width:120px;border-radius:8px" /></div>
            }
            <input type="file" name="ImageFile" accept=".jpg,.jpeg,.png,.webp" class="form-control" data-preview="imgPreview" />
            <div style="margin-top:8px"><img id="imgPreview" src="" style="display:none;max-width:200px;border-radius:8px" /></div>
            <small class="text-muted">Max 2 MB. Formats: jpg, jpeg, png, webp</small>
        </div>
        <div style="margin-top:18px">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Stores/Detail/@Model.Id" class="btn btn-secondary" style="margin-left:8px">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

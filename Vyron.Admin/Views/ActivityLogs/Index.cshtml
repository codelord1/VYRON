@model List<ActivityLog>
@{ ViewData["Title"] = "Activity Logs"; }
@{
    var search = (string?)ViewBag.Search;
    var page   = (int)(ViewBag.Page ?? 1);
    var total  = (int)(ViewBag.Total ?? 0);
    var pages  = (int)Math.Ceiling(total / 50.0);
}

<div class="page-header">
    <h1>Activity Logs</h1>
    <small class="text-muted">@total entries</small>
</div>

<form method="get" class="filters-row">
    <input name="search" value="@search" class="form-control" placeholder="Search activity type, entity or user…" style="max-width:260px" />
    <button class="btn btn-primary btn-sm">Search</button>
    @if (!string.IsNullOrEmpty(search)) { <a href="/ActivityLogs" class="btn btn-ghost btn-sm">Clear</a> }
</form>

<div class="table-wrap">
    <table class="table-mobile-card">
        <thead>
            <tr><th>When</th><th>User</th><th>Activity</th><th>Entity</th><th>Description</th><th>IP</th></tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td><small>@log.CreatedAt.ToLocalTime().ToString("MMM d HH:mm:ss")</small></td>
                    <td><small>@(log.User?.FullName ?? log.UserId?.ToString("N")[..8] ?? "System")</small></td>
                    <td><span class="badge badge-info">@log.ActivityType</span></td>
                    <td><small>@log.EntityType @(log.EntityId.HasValue ? "(" + log.EntityId.Value.ToString("N")[..8] + "…)" : "")</small></td>
                    <td><small>@log.Description</small></td>
                    <td><small class="text-muted">@log.IpAddress</small></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (pages > 1)
{
    <div class="pagination">
        @for (int p = 1; p <= pages; p++)
        {
            <a href="/ActivityLogs?search=@search&page=@p" class="btn btn-sm @(p == page ? "btn-primary" : "btn-ghost")">@p</a>
        }
    </div>
}

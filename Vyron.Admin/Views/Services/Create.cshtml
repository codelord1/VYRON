@model ServiceOfferingCreateVm
@{
    ViewData["Title"] = "Add Service Offering";
    ViewData["Subtitle"] = "Create a service offering for any store";
}

<div class="page-header">
    <div>
        <h1>Add Service Offering</h1>
        <p>Set service catalog details, price, and availability.</p>
    </div>
    <a href="/Services" class="btn btn-secondary btn-sm">Back</a>
</div>

<div class="card service-form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="form-group">
            <label asp-for="StoreId">Store *</label>
            <select asp-for="StoreId" class="form-control">
                <option value="">Select store</option>
                @foreach (var s in (IEnumerable<LaundryStore>)(ViewBag.Stores ?? new List<LaundryStore>()))
                { <option value="@s.Id" selected="@(Model.StoreId == s.Id)">@s.Name</option> }
            </select>
            <span asp-validation-for="StoreId" class="text-red"></span>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="Name">Service Name *</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Wash & Iron" />
                <span asp-validation-for="Name" class="text-red"></span>
            </div>
            <div class="form-group">
                <label asp-for="Category">Category</label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Standard, Premium" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="ServiceTypeEntityId">Service Type</label>
                <select asp-for="ServiceTypeEntityId" class="form-control">
                    <option value="">— Select type —</option>
                    @foreach (var st in (IEnumerable<ServiceTypeEntity>)(ViewBag.ServiceTypes ?? new List<ServiceTypeEntity>()))
                    { <option value="@st.Id">@st.Name</option> }
                </select>
                <small class="text-muted">Manage types under <a href="/ServiceTypes">Service Types</a>.</small>
            </div>
            <div class="form-group">
                <label asp-for="PricingMode">Pricing Mode</label>
                <select asp-for="PricingMode" class="form-control">
                    @foreach (PricingMode v in Enum.GetValues(typeof(PricingMode)))
                    { <option value="@((int)v)">@v</option> }
                </select>
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-group">
                <label asp-for="BasePrice">Base Price (&#8358;) *</label>
                <input asp-for="BasePrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="BasePrice" class="text-red"></span>
            </div>
            <div class="form-group">
                <label asp-for="MinimumCharge">Minimum Charge (&#8358;)</label>
                <input asp-for="MinimumCharge" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="EstimatedHours">Est. Hours</label>
                <input asp-for="EstimatedHours" type="number" min="1" class="form-control" />
            </div>
        </div>

        <label class="toggle-row">
            <input asp-for="IsActive" type="checkbox" />
            <span>Active (available for new orders)</span>
        </label>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Service</button>
            <a href="/Services" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

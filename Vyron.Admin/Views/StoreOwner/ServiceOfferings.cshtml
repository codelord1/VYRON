@model List<ServiceOffering>
@{
    ViewData["Title"] = "My Service Offerings";
    ViewData["Subtitle"] = "Manage your laundry services, pricing and availability";
    var activeCount   = Model.Count(s => s.IsActive);
    var inactiveCount = Model.Count(s => !s.IsActive);
}

<div class="page-header">
    <div>
        <h1>Service Offerings</h1>
        <p class="text-muted" style="margin:0;">
            <span class="badge badge-success">@activeCount active</span>
            @if (inactiveCount > 0) { <span class="badge badge-gray" style="margin-left:4px;">@inactiveCount inactive</span> }
        </p>
    </div>
    <a href="/StoreOwner/ServiceCreate" class="btn btn-primary">+ Add Service</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state" style="text-align:center;padding:64px 20px;">
        <div style="font-size:48px;margin-bottom:12px;">S</div>
        <h3>No service offerings yet</h3>
        <p class="text-muted">Add your first laundry service to start accepting orders from customers.</p>
        <a href="/StoreOwner/ServiceCreate" class="btn btn-primary" style="margin-top:8px;">Add Service</a>
    </div>
}
else
{
    @* ── Store filter if multiple stores ── *@
    @if (Model.Select(s => s.StoreId).Distinct().Count() > 1)
    {
        <div class="filter-bar" style="margin-bottom:1rem;">
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <span style="font-size:13px;font-weight:600;color:var(--muted);">Filter by store:</span>
                <a href="/StoreOwner/ServiceOfferings" class="period-btn">All</a>
                @foreach (var storeGroup in Model.GroupBy(s => new { s.StoreId, Name = s.Store?.Name ?? "Store" }))
                {
                    <a href="/StoreOwner/ServiceOfferings?storeId=@storeGroup.Key.StoreId"
                       class="period-btn">@storeGroup.Key.Name</a>
                }
            </div>
        </div>
    }

    @* ── Service table (desktop) ── *@
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Store</th>
                    <th>Type</th>
                    <th class="text-right">Base Price</th>
                    <th class="text-right">Min. Charge</th>
                    <th class="text-right">Est. Hours</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <strong>@s.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <br /><small class="text-muted">@(s.Description.Length > 60 ? s.Description[..60] + "…" : s.Description)</small>
                            }
                        </td>
                        <td>@(s.Store?.Name ?? "—")</td>
                        <td>
                            <span class="badge badge-gray" style="font-size:11px;">@(s.Category ?? s.ServiceType.ToString())</span>
                        </td>
                        <td class="text-right text-bold">&#8358;@s.BasePrice.ToString("N0")</td>
                        <td class="text-right">@(s.MinimumCharge > 0 ? "&#8358;" + s.MinimumCharge.ToString("N0") : "—")</td>
                        <td class="text-right">@s.EstimatedHours h</td>
                        <td>
                            @if (s.IsActive)
                            { <span class="badge badge-success">Active</span> }
                            else
                            { <span class="badge badge-gray">Inactive</span> }
                        </td>
                        <td>
                            <div class="action-row">
                                <a href="/StoreOwner/ServiceEdit/@s.Id" class="btn btn-ghost btn-sm">Edit</a>
                                <form asp-controller="StoreOwner" asp-action="ToggleServiceActive" method="post" style="display:inline;"
                                      data-confirm="@(s.IsActive ? "Deactivate this service? Customers will not see it." : "Activate this service?")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-warning" : "btn-primary")">
                                        @(s.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Service cards (mobile) ── *@
    <div class="service-mobile-only" style="display:none;gap:12px;">
        @foreach (var s in Model)
        {
            <div class="card" style="padding:16px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                    <div>
                        <strong>@s.Name</strong>
                        <div style="font-size:12px;color:var(--muted);margin-top:2px;">@(s.Store?.Name ?? "—") &middot; @(s.Category ?? s.ServiceType.ToString())</div>
                    </div>
                    @if (s.IsActive)
                    { <span class="badge badge-success" style="flex-shrink:0;">Active</span> }
                    else
                    { <span class="badge badge-gray" style="flex-shrink:0;">Inactive</span> }
                </div>
                <div style="display:flex;gap:16px;margin-top:12px;flex-wrap:wrap;">
                    <div><div class="stat-label" style="font-size:10px;">Price</div><strong>&#8358;@s.BasePrice.ToString("N0")</strong></div>
                    <div><div class="stat-label" style="font-size:10px;">Est. Hours</div><strong>@s.EstimatedHours h</strong></div>
                    @if (s.MinimumCharge > 0)
                    {
                        <div><div class="stat-label" style="font-size:10px;">Min. Charge</div><strong>&#8358;@s.MinimumCharge.ToString("N0")</strong></div>
                    }
                </div>
                <div style="display:flex;gap:8px;margin-top:12px;">
                    <a href="/StoreOwner/ServiceEdit/@s.Id" class="btn btn-ghost btn-sm" style="flex:1;text-align:center;">Edit</a>
                    <form asp-controller="StoreOwner" asp-action="ToggleServiceActive" method="post" style="flex:1;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-warning" : "btn-primary")" style="width:100%;">
                            @(s.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
// Show mobile cards on small screens
(function () {
    function check() {
        var isMobile = window.innerWidth <= 768;
        document.querySelectorAll('.service-mobile-only').forEach(function (el) { el.style.display = isMobile ? 'grid' : 'none'; });
        document.querySelectorAll('.admin-table-wrap').forEach(function (el) { el.style.display = isMobile ? 'none' : ''; });
    }
    check();
    window.addEventListener('resize', check);
})();
</script>
}

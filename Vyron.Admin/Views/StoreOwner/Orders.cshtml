@model List<Order>
@{ ViewData["Title"] = "My Orders"; var status = (OrderStatus?)ViewBag.Status; }

<div class="page-header">
    <h1>My Orders</h1>
    <span class="text-muted">Showing @Model.Count results</span>
</div>

<form class="filters" method="get">
    <div class="form-group">
        <label>Status</label>
        <select name="status">
            <option value="">All statuses</option>
            <option value="PickupFeePaid" selected="@(status == OrderStatus.PickupFeePaid)">Awaiting Acceptance ⚠️</option>
            <option value="Confirmed" selected="@(status == OrderStatus.Confirmed)">Accepted</option>
            <option value="PickedUp" selected="@(status == OrderStatus.PickedUp)">Picked Up</option>
            <option value="Processing" selected="@(status == OrderStatus.Processing)">Processing</option>
            <option value="Ready" selected="@(status == OrderStatus.Ready)">Ready</option>
            <option value="OutForDelivery" selected="@(status == OrderStatus.OutForDelivery)">Out for Delivery</option>
            <option value="Delivered" selected="@(status == OrderStatus.Delivered)">Delivered</option>
            <option value="Completed" selected="@(status == OrderStatus.Completed)">Completed</option>
            <option value="Disputed" selected="@(status == OrderStatus.Disputed)">Disputed</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/StoreOwner/Orders" class="btn btn-secondary btn-sm">Reset</a>
</form>

<div class="table-wrap">
    <table class="table-mobile-card">
        <thead>
            <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Status</th><th>Rider</th><th>Total</th><th>Placed</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td><a href="/StoreOwner/OrderDetail/@o.Id" class="text-bold">@o.OrderNumber</a></td>
                    <td>@o.Customer.FullName<br /><small class="text-muted">@o.Customer.Phone</small></td>
                    <td>@o.Service.Name</td>
                    <td><span class="badge badge-@StatusBadge(o.Status)">@o.Status</span></td>
                    <td>@(o.Rider?.User.FullName ?? "—")</td>
                    <td class="text-bold">₦@o.TotalEstimate.ToString("N0")</td>
                    <td><small>@o.CreatedAt.ToString("MMM dd HH:mm")</small></td>
                    <td><a href="/StoreOwner/OrderDetail/@o.Id" class="btn btn-secondary btn-sm">View</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted" style="padding:30px;">No orders match the filter.</td></tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Confirmed or OrderStatus.PickupFeePaid or OrderStatus.RiderAssigned => "info",
        OrderStatus.PickedUp or OrderStatus.OutForDelivery => "purple",
        OrderStatus.Processing => "warning",
        OrderStatus.Ready or OrderStatus.Delivered or OrderStatus.BalancePaid or OrderStatus.Completed => "success",
        OrderStatus.Disputed => "danger",
        _ => "gray"
    };
}

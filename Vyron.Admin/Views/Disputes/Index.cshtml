@model List<Dispute>
@{ ViewData["Title"] = "Disputes"; var status = (DisputeStatus?)ViewBag.Status; }

<div class="page-header">
    <h1>Disputes</h1>
    <span class="text-muted">@Model.Count total</span>
</div>

<form class="filters" method="get">
    <div class="form-group">
        <label>Status</label>
        <select name="status">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<DisputeStatus>())
            { <option value="@s" selected="@(status == s)">@s</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/Disputes" class="btn btn-secondary btn-sm">Reset</a>
</form>

<div class="table-wrap">
    <table class="table-mobile-card">
        <thead>
            <tr><th>Order #</th><th>Customer</th><th>Type</th><th>Status</th><th>Raised</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted" style="padding:30px;">No disputes 🎉</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td><a href="/Disputes/Detail/@d.Id" class="text-bold">@d.Order.OrderNumber</a></td>
                    <td>@d.RaisedBy.FullName</td>
                    <td><span class="badge badge-warning">@d.Type</span></td>
                    <td><span class="badge badge-@StatusBadge(d.Status)">@d.Status</span></td>
                    <td>@d.CreatedAt.ToString("MMM dd")</td>
                    <td><a href="/Disputes/Detail/@d.Id" class="btn btn-secondary btn-sm">View →</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@functions {
    string StatusBadge(DisputeStatus s) => s switch
    {
        DisputeStatus.Open => "danger",
        DisputeStatus.UnderReview or DisputeStatus.AwaitingResponse => "warning",
        DisputeStatus.Resolved or DisputeStatus.Refunded => "success",
        DisputeStatus.Rejected => "gray",
        _ => "gray"
    };
}

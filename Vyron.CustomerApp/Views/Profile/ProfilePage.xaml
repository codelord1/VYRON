<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Profile.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My Profile"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="22,24,22,30" Spacing="16">
            <Border BackgroundColor="{StaticResource TealDark}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">
                <Grid ColumnDefinitions="70,*" ColumnSpacing="14">
                    <Border BackgroundColor="White"
                            WidthRequest="64"
                            HeightRequest="64"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 22">
                        <Label Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                               TextColor="{StaticResource TealDark}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding FullName}"
                               TextColor="White"
                               FontFamily="OpenSansSemibold"
                               FontSize="22" />
                        <Label Text="{Binding Phone}"
                               TextColor="#D9F8EC"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="#EFFFF8"
                    Stroke="#A5E7D1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12"
                    IsVisible="{Binding SuccessMessage, Converter={StaticResource NotNullToBool}}">
                <Label Text="{Binding SuccessMessage}" TextColor="{StaticResource TealDark}" FontSize="13" />
            </Border>
            <Border BackgroundColor="#FFF4F3"
                    Stroke="#FFD4D1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                <Label Text="{Binding ErrorMessage}" TextColor="#C73535" FontSize="13" />
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Profile details"
                           FontFamily="OpenSansSemibold"
                           FontSize="18" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Full name" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 22" HeightRequest="52">
                            <Entry Text="{Binding FullName}"
                                   IsReadOnly="{Binding EditMode, Converter={StaticResource InvertBool}}"
                                   Margin="16,0" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Email" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 22" HeightRequest="52">
                            <Entry Text="{Binding Email}"
                                   Placeholder="your@email.com"
                                   Keyboard="Email"
                                   IsReadOnly="{Binding EditMode, Converter={StaticResource InvertBool}}"
                                   Margin="16,0" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Edit Profile"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                    TextColor="{StaticResource TealDark}"
                    BorderColor="{StaticResource Teal}"
                    BorderWidth="1"
                    IsVisible="{Binding EditMode, Converter={StaticResource InvertBool}}"
                    Clicked="OnEditClicked" />

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    IsVisible="{Binding EditMode}"
                    IsEnabled="{Binding IsNotBusy}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Teal}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Button Text="Sign Out"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Danger}"
                    FontSize="14"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

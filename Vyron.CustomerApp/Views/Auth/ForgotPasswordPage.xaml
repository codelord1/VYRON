<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,48" Spacing="0">

            <!-- ── Brand ───────────────────────────────────────────── -->
            <Image Source="vyron_logo_primary.png"
                   HeightRequest="60"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,20,0,24" />
            <!--<Label Text="VYRON"
                   TextColor="{StaticResource Teal}"
                   FontFamily="OpenSansSemibold"
                   FontSize="42"
                   HorizontalOptions="Center" />-->
            <Label Text="Laundry, simplified."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,28" />

            <!-- ── Card ────────────────────────────────────────────── -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                    Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                    StrokeShape="RoundRectangle 20"
                    Padding="24,28">
                <VerticalStackLayout Spacing="0">

                    <Label Text="Reset Password"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           Margin="0,0,0,6" />
                    <Label Text="Enter your phone number and we'll send you a verification code to reset your password."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           HorizontalTextAlignment="Start"
                           Margin="0,0,0,24" />

                    <!-- Error banner -->
                    <Border BackgroundColor="#FFF1F0"
                            Stroke="#FFB8B0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C0392B"
                               FontSize="12" />
                    </Border>

                    <!-- Phone Number label -->
                    <Label Text="Phone Number"
                           FontSize="13"
                           FontFamily="OpenSansSemibold"
                           Margin="0,0,0,8" />

                    <!-- Country picker + local number row -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,24">

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeShape="RoundRectangle 12"
                                WidthRequest="148">
                            <Picker ItemsSource="{Binding CountryOptions}"
                                    SelectedItem="{Binding SelectedCountry}"
                                    ItemDisplayBinding="{Binding DisplayText, x:DataType=dto:CountryCodeOption}"
                                    BackgroundColor="Transparent"
                                    Margin="10,0" />
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeShape="RoundRectangle 12">
                            <Entry Placeholder="8012345678"
                                   Text="{Binding LocalPhone}"
                                   Keyboard="Telephone"
                                   BackgroundColor="Transparent"
                                   ReturnType="Send"
                                   ReturnCommand="{Binding RequestResetOtpCommand}"
                                   Margin="14,0" />
                        </Border>
                    </Grid>

                    <Button Text="Send Reset Code"
                            Command="{Binding RequestResetOtpCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource Teal}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       Margin="0,12,0,0" />

                    <Button Text="← Back to Login"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                            FontSize="13"
                            Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

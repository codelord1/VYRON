<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Auth.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="28,64,28,48" Spacing="0">

            <!-- ── Brand ───────────────────────────────────────────── -->
            <Label Text="VYRON"
                   TextColor="{StaticResource Teal}"
                   FontFamily="OpenSansSemibold"
                   FontSize="42"
                   HorizontalOptions="Center" />
            <Label Text="Laundry, simplified."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center"
                   Margin="0,4,0,48" />

            <!-- ── Card ────────────────────────────────────────────── -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                    Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                    StrokeShape="RoundRectangle 20"
                    Padding="24,28">
                <VerticalStackLayout Spacing="0">

                    <Label Text="Set New Password"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           Margin="0,0,0,6" />
                    <Label Text="Enter the verification code sent to your phone and choose a new password."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           Margin="0,0,0,24" />

                    <!-- Error banner -->
                    <Border BackgroundColor="#FFF1F0"
                            Stroke="#FFB8B0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C0392B"
                               FontSize="12" />
                    </Border>

                    <!-- Success banner -->
                    <Border BackgroundColor="#F0FFF4"
                            Stroke="#86EFAC"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            IsVisible="{Binding SuccessMessage, Converter={StaticResource NotNullToBool}}">
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="#166534"
                               FontSize="12" />
                    </Border>

                    <!-- ⚠️ DEV MODE BANNER -->
                    <Border BackgroundColor="#FFF8E1"
                            Stroke="#FFC107"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,12"
                            Margin="0,0,0,16"
                            IsVisible="{Binding HasDevOtp}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🔧 Development Mode"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#7B5800"
                                   FontSize="12" />
                            <Label FontSize="15" FontFamily="OpenSansSemibold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Your reset code: "
                                              TextColor="#5C4400" />
                                        <Span Text="{Binding DevOtp}"
                                              TextColor="#7B5800"
                                              FontSize="26"
                                              FontFamily="OpenSansSemibold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="This banner only appears in development. SMS is not sent in dev mode."
                                   TextColor="#7B5800"
                                   FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Verification code -->
                    <Label Text="Verification Code"
                           FontSize="13"
                           FontFamily="OpenSansSemibold"
                           Margin="0,0,0,8" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,0,0,20">
                        <Entry Placeholder="000000"
                               Text="{Binding OtpCode}"
                               Keyboard="Numeric"
                               MaxLength="6"
                               FontFamily="OpenSansSemibold"
                               FontSize="28"
                               HorizontalTextAlignment="Center"
                               BackgroundColor="Transparent"
                               ReturnType="Next"
                               Margin="14,8" />
                    </Border>

                    <!-- New password -->
                    <Label Text="New Password"
                           FontSize="13"
                           FontFamily="OpenSansSemibold"
                           Margin="0,0,0,8" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Placeholder="At least 6 characters"
                                   Text="{Binding NewPassword}"
                                   IsPassword="{Binding ShowPassword, Converter={StaticResource InvertBool}}"
                                   BackgroundColor="Transparent"
                                   ReturnType="Next"
                                   Margin="14,0" />
                            <Button Grid.Column="1"
                                    Text="{Binding PasswordToggleIcon}"
                                    Command="{Binding TogglePasswordCommand}"
                                    BackgroundColor="Transparent"
                                    FontSize="16"
                                    Padding="8,0"
                                    WidthRequest="44" />
                        </Grid>
                    </Border>

                    <!-- Confirm new password -->
                    <Label Text="Confirm New Password"
                           FontSize="13"
                           FontFamily="OpenSansSemibold"
                           Margin="0,0,0,8" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,0,0,24">
                        <Entry Placeholder="Repeat your new password"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="{Binding ShowPassword, Converter={StaticResource InvertBool}}"
                               BackgroundColor="Transparent"
                               ReturnType="Done"
                               ReturnCommand="{Binding ResetCommand}"
                               Margin="14,0" />
                    </Border>

                    <Button Text="Reset Password"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource Teal}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       Margin="0,12,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

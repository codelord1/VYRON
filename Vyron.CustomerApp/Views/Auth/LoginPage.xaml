<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid>
    <ScrollView IsEnabled="{Binding IsNotBusy}">
        <VerticalStackLayout Padding="26,50,26,36" Spacing="0">

            <HorizontalStackLayout Spacing="10" Margin="0,0,0,44">
                <Border BackgroundColor="{StaticResource Teal}"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 21"
                        Stroke="Transparent">
                    <Label Text="~"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="VYRON"
                       TextColor="{StaticResource Gray5}"
                       FontFamily="OpenSansSemibold"
                       FontSize="22"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Welcome back"
                   FontFamily="OpenSansSemibold"
                   FontSize="30"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,4" />
            <Label Text="Sign in to schedule your next pickup."
                   FontSize="15"
                   TextColor="{StaticResource Gray3}"
                   Margin="0,0,0,28" />

            <Border BackgroundColor="#FFF4F3"
                    Stroke="#FFD4D1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#C73535"
                       FontSize="13" />
            </Border>

            <Label Text="Phone"
                   FontSize="13"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,8" />
            <Grid ColumnDefinitions="150,*" ColumnSpacing="8" Margin="0,0,0,18">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="52">
                    <Picker ItemsSource="{Binding CountryOptions}"
                            SelectedItem="{Binding SelectedCountry}"
                            ItemDisplayBinding="{Binding DisplayText}"
                            BackgroundColor="Transparent"
                            Margin="12,0" />
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="52">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,0">
                        <Path Stroke="{StaticResource Gray3}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              WidthRequest="18"
                              HeightRequest="18"
                              VerticalOptions="Center"
                              Data="M7,3 C6.2,3 5.5,3.6 5.4,4.4 C5.1,6.4 5.7,8.8 7.4,11.6 C9.1,14.4 11.1,16.1 13.1,16.8 C13.9,17.1 14.8,16.8 15.2,16.1 L16,14.7 C16.3,14.1 16.1,13.3 15.5,13 L13.7,12.1 C13.2,11.8 12.6,11.9 12.2,12.3 L11.5,13 C10.4,12.4 9.5,11.5 8.8,10.4 C8.1,9.3 7.7,8.2 7.7,7 L8.6,6.7 C9.2,6.5 9.6,6 9.5,5.4 L9.2,3.9 C9.1,3.4 8.6,3 8,3 Z" />
                        <Entry Grid.Column="1"
                               Placeholder="8091679000"
                               Text="{Binding LocalPhone}"
                               Keyboard="Telephone"
                               ReturnType="Next" />
                    </Grid>
                </Border>
            </Grid>

            <Label Text="Password"
                   FontSize="13"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="White"
                    Stroke="{StaticResource CardStroke}"
                    StrokeShape="RoundRectangle 24"
                    HeightRequest="52"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,0">
                    <Path Stroke="{StaticResource Gray3}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          WidthRequest="18"
                          HeightRequest="18"
                          VerticalOptions="Center"
                          Data="M6,10 L6,7 C6,4.8 7.8,3 10,3 C12.2,3 14,4.8 14,7 L14,10 M5,10 L15,10 C16.1,10 17,10.9 17,12 L17,18 C17,19.1 16.1,20 15,20 L5,20 C3.9,20 3,19.1 3,18 L3,12 C3,10.9 3.9,10 5,10 Z" />
                    <Entry Grid.Column="1"
                           Placeholder="Password"
                           Text="{Binding Password}"
                           IsPassword="{Binding ShowPassword, Converter={StaticResource InvertBool}}"
                           ReturnType="Done"
                           ReturnCommand="{Binding LoginCommand}" />
                    <Border Grid.Column="2"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Path Stroke="{StaticResource Gray3}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Data="M2,10 C4,6.5 6.7,5 10,5 C13.3,5 16,6.5 18,10 C16,13.5 13.3,15 10,15 C6.7,15 4,13.5 2,10 Z M10,8 C11.1,8 12,8.9 12,10 C12,11.1 11.1,12 10,12 C8.9,12 8,11.1 8,10 C8,8.9 8.9,8 10,8 Z" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleRememberMeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Switch IsToggled="{Binding RememberMe}"
                            OnColor="{StaticResource Teal}"
                            ThumbColor="White"
                            Scale="0.72" />
                    <Label Text="Remember me"
                           FontSize="13"
                           TextColor="{StaticResource Gray3}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Grid.Column="2"
                       Text="Forgot password?"
                       TextColor="{StaticResource TealDark}"
                       FontSize="13"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,30,0,28">
                <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="or continue with" FontSize="12" TextColor="{StaticResource Gray3}" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource CardStroke}" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="50">
                    <Label Text="Google"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="50">
                    <Label Text="Apple"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                </Border>
            </Grid>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,42,0,0" Spacing="4">
                <Label Text="New to VYRON?"
                       FontSize="14"
                       TextColor="{StaticResource Gray3}" />
                <Label Text="Create an account"
                       FontSize="14"
                       TextColor="{StaticResource TealDark}"
                       FontFamily="OpenSansSemibold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSignupCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    <Grid BackgroundColor="#66F4FAF7"
          IsVisible="{Binding IsBusy}">
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           Color="{StaticResource Teal}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
    </Grid>
</ContentPage>

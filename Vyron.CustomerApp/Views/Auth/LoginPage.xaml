<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <ScrollView>
        <VerticalStackLayout Padding="26,50,26,36" Spacing="0">

            <HorizontalStackLayout Spacing="10" Margin="0,0,0,44">
                <Border BackgroundColor="{StaticResource Teal}"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 21"
                        Stroke="Transparent">
                    <Label Text="~"
                           TextColor="White"
                           FontFamily="OpenSansSemibold"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="VYRON"
                       TextColor="{StaticResource Gray5}"
                       FontFamily="OpenSansSemibold"
                       FontSize="22"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Welcome back"
                   FontFamily="OpenSansSemibold"
                   FontSize="30"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,4" />
            <Label Text="Sign in to schedule your next pickup."
                   FontSize="15"
                   TextColor="{StaticResource Gray3}"
                   Margin="0,0,0,28" />

            <Border BackgroundColor="#FFF4F3"
                    Stroke="#FFD4D1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14,12"
                    Margin="0,0,0,16"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#C73535"
                       FontSize="13" />
            </Border>

            <Label Text="Email or phone number"
                   FontSize="13"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,8" />
            <Grid ColumnDefinitions="112,*" ColumnSpacing="8" Margin="0,0,0,18">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="52">
                    <Picker ItemsSource="{Binding CountryOptions}"
                            SelectedItem="{Binding SelectedCountry}"
                            ItemDisplayBinding="{Binding DialCode}"
                            BackgroundColor="Transparent"
                            Margin="12,0" />
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="52">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,0">
                        <Label Text="Mail"
                               FontSize="12"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="you@example.com"
                               Text="{Binding LocalPhone}"
                               Keyboard="Telephone"
                               ReturnType="Next" />
                    </Grid>
                </Border>
            </Grid>

            <Label Text="Password"
                   FontSize="13"
                   TextColor="{StaticResource Gray5}"
                   Margin="0,0,0,8" />
            <Border BackgroundColor="White"
                    Stroke="{StaticResource CardStroke}"
                    StrokeShape="RoundRectangle 24"
                    HeightRequest="52"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,0">
                    <Label Text="Lock"
                           FontSize="12"
                           TextColor="{StaticResource Gray3}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Placeholder="Password"
                           Text="{Binding Password}"
                           IsPassword="{Binding ShowPassword, Converter={StaticResource InvertBool}}"
                           ReturnType="Done"
                           ReturnCommand="{Binding LoginCommand}" />
                    <Button Grid.Column="2"
                            Text="{Binding PasswordToggleIcon}"
                            Command="{Binding TogglePasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Gray3}"
                            FontSize="14"
                            Padding="0"
                            WidthRequest="36"
                            HeightRequest="36" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleRememberMeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Switch IsToggled="{Binding RememberMe}"
                            OnColor="{StaticResource Teal}"
                            ThumbColor="White"
                            Scale="0.72" />
                    <Label Text="Remember me"
                           FontSize="13"
                           TextColor="{StaticResource Gray3}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Grid.Column="2"
                       Text="Forgot password?"
                       TextColor="{StaticResource TealDark}"
                       FontSize="13"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Teal}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,16,0,0" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,30,0,28">
                <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="or continue with" FontSize="12" TextColor="{StaticResource Gray3}" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource CardStroke}" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="50">
                    <Label Text="Google"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="{StaticResource CardStroke}"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="50">
                    <Label Text="Apple"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                </Border>
            </Grid>

            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,42,0,0" Spacing="4">
                <Label Text="New to VYRON?"
                       FontSize="14"
                       TextColor="{StaticResource Gray3}" />
                <Label Text="Create an account"
                       FontSize="14"
                       TextColor="{StaticResource TealDark}"
                       FontFamily="OpenSansSemibold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSignupCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

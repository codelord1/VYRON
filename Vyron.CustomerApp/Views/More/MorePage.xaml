<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.More.MorePage"
             x:DataType="vm:MoreViewModel"
             Title="More"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid BackgroundColor="{StaticResource TealDark}"
                  Padding="22,50,22,70">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                        <Border BackgroundColor="White"
                                WidthRequest="64"
                                HeightRequest="64"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 22">
                            <Label Text="{Binding UserInitials}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   TextColor="{StaticResource TealDark}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding UserName}"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22" />
                            <Label Text="{Binding UserPhone}"
                                   TextColor="#D9F8EC"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border BackgroundColor="#1D9678"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            Padding="18,14">
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="24" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" />
                                <Label Text="ORDERS" TextColor="#D9F8EC" FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="N12k" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" />
                                <Label Text="SAVED" TextColor="#D9F8EC" FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                <Label Text="4.9" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" HorizontalTextAlignment="Center" />
                                <Label Text="RATING" TextColor="#D9F8EC" FontSize="11" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="22,0,22,28" Spacing="14" Margin="0,-48,0,0">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Pin" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Manage addresses" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentMethodsTapped" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Card" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Payment methods" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Wallet coming soon" FontSize="11" TextColor="{StaticResource Gray3}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />
                        <Grid ColumnDefinitions="52,*,Auto,Auto" ColumnSpacing="12" Padding="16,16">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Bell" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Notifications" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Border Grid.Column="2" BackgroundColor="{StaticResource Danger}" Stroke="Transparent" StrokeShape="RoundRectangle 10" Padding="7,2" VerticalOptions="Center">
                                <Label Text="3" TextColor="White" FontSize="11" FontFamily="OpenSansSemibold" />
                            </Border>
                            <Label Grid.Column="3" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToDisputeHistoryCommand}" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Warn" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="My disputes" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Help" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Help &amp; support" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Doc" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Terms &amp; conditions" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" />
                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Padding="16,16">
                            <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                <Label Text="Shield" FontSize="10" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Privacy policy" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Log out"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="White"
                        BorderColor="#FF9FA6"
                        BorderWidth="1"
                        TextColor="{StaticResource Danger}"
                        Margin="0,0,0,8" />

                <Label Text="VYRON v1.0.0"
                       FontSize="11"
                       TextColor="{StaticResource Gray3}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

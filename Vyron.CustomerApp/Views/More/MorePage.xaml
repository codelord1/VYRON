<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.More.MorePage"
             x:DataType="vm:MoreViewModel"
             Title="More"
             BackgroundColor="{StaticResource Bg}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── User profile header ─────────────────────────────── -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="20,24,20,20">
                <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">

                    <!-- Avatar circle -->
                    <Border BackgroundColor="{StaticResource Teal}"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 26"
                            Stroke="Transparent"
                            VerticalOptions="Center">
                        <Label Text="{Binding UserInitials}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Name + phone -->
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding UserName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="16" />
                        <Label Text="{Binding UserPhone}"
                               FontSize="12"
                               TextColor="{StaticResource Gray3}" />
                    </VerticalStackLayout>

                    <!-- Edit chevron -->
                    <Label Grid.Column="2"
                           Text="›"
                           FontSize="22"
                           TextColor="{StaticResource Gray3}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>
            </Border>

            <BoxView HeightRequest="8" Color="{StaticResource Bg}" />

            <!-- ── Account section ────────────────────────────────── -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="20,14">
                <VerticalStackLayout Spacing="0">

                    <Label Text="Account"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           TextColor="{StaticResource Gray3}"
                           Margin="0,0,0,10" />

                    <!-- Profile -->
                    <Grid ColumnDefinitions="32,*,Auto"
                          ColumnSpacing="12"
                          Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="👤" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Edit Profile"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0EFE9" />

                    <!-- Order history -->
                    <Grid ColumnDefinitions="32,*,Auto"
                          ColumnSpacing="12"
                          Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToOrderHistoryCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="📋" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Order History"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0EFE9" />

                    <!-- Dispute history -->
                    <Grid ColumnDefinitions="32,*,Auto"
                          ColumnSpacing="12"
                          Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToDisputeHistoryCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="⚖️" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Dispute History"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0EFE9" />

                    <!-- Notifications -->
                    <Grid ColumnDefinitions="32,*,Auto"
                          ColumnSpacing="12"
                          Padding="0,12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToNotificationsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="🔔" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Notifications"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="8" Color="{StaticResource Bg}" />

            <!-- ── Support section ────────────────────────────────── -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="20,14">
                <VerticalStackLayout Spacing="0">

                    <Label Text="Support"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           TextColor="{StaticResource Gray3}"
                           Margin="0,0,0,10" />

                    <!-- Help / FAQ -->
                    <Grid ColumnDefinitions="32,*,Auto"
                          ColumnSpacing="12"
                          Padding="0,12">
                        <Label Text="❓" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Help &amp; FAQ"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="18"
                               TextColor="{StaticResource Gray3}"
                               VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="8" Color="{StaticResource Bg}" />

            <!-- ── Sign out ────────────────────────────────────────── -->
            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="20,4">
                <Grid ColumnDefinitions="32,*"
                      ColumnSpacing="12"
                      Padding="0,14">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="🚪" FontSize="18" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Sign Out"
                           FontSize="14"
                           TextColor="#E74C3C"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <BoxView HeightRequest="32" Color="Transparent" />

            <!-- App version footer -->
            <Label Text="VYRON v1.0 · Lagos, Nigeria"
                   FontSize="11"
                   TextColor="{StaticResource Gray3}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

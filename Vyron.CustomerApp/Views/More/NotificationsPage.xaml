<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.More.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="Transparent"
                Padding="20,16,20,14">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Notifications"
                           FontFamily="OpenSansSemibold"
                           FontSize="20" />
                    <Label Text="Your order and account updates"
                           FontSize="12"
                           TextColor="{StaticResource Gray3}" />
                </VerticalStackLayout>
                <!-- Mark all read -->
                <Label Grid.Column="1"
                       Text="Mark all read"
                       FontSize="12"
                       TextColor="{StaticResource Teal}"
                       VerticalOptions="Center">
                    <Label.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Label.Behaviors>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MarkAllReadCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource Teal}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   Margin="0,60" />

                <!-- Notification list -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                     IsVisible="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                                     Spacing="0"
                                     Padding="0,8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:NotificationDto">
                            <Border BackgroundColor="White"
                                    Stroke="Transparent"
                                    Margin="0,0,0,1"
                                    Padding="20,14">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Grid ColumnDefinitions="8,*">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=MarkReadCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Unread indicator dot -->
                                    <BoxView Grid.Column="0"
                                             WidthRequest="6"
                                             HeightRequest="6"
                                             CornerRadius="3"
                                             Color="{StaticResource Teal}"
                                             VerticalOptions="Start"
                                             Margin="0,4,0,0">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView"
                                                         Binding="{Binding IsRead}"
                                                         Value="True">
                                                <Setter Property="Color" Value="Transparent" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>

                                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsRead}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Gray3}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Message}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray3}"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding TimeDisplay}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray3}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     HorizontalOptions="Center"
                                     Spacing="12"
                                     Padding="40,80">
                    <Label Text="🔔"
                           FontSize="56"
                           HorizontalOptions="Center" />
                    <Label Text="No notifications yet"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalOptions="Center" />
                    <Label Text="Order updates and account alerts will appear here."
                           FontSize="13"
                           TextColor="{StaticResource Gray3}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>

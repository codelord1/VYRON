<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Orders.ServiceSelectionPage"
             x:DataType="vm:ServiceSelectionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="*,Auto">

        <!-- ── Scrollable content ──────────────────────────────── -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding GroupedServiceCards}"
                        IsGrouped="True"
                        SelectionMode="None">

            <!-- ══════════════════════════════════════════════════
                 HEADER  (back button · title · store card · search)
                 ══════════════════════════════════════════════════ -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="18,22,18,4" Spacing="16">

                    <!-- Back button + "Build your basket" title -->
                    <Grid ColumnDefinitions="52,*" ColumnSpacing="14">
                        <Border WidthRequest="46"
                                HeightRequest="46"
                                StrokeShape="RoundRectangle 15"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}">
                            <Border.Behaviors><behaviors:TapFeedbackBehavior /></Border.Behaviors>
                            <Path Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                  StrokeThickness="2.5"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  WidthRequest="20"
                                  HeightRequest="20"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  Data="M18,10 L4,10 M10,4 L4,10 L10,16" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Build your basket"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                            <Label Text="{Binding StoreSubtitleText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ── Store info card (replaces the green hero banner) ── -->
                    <Border StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeThickness="1.2"
                            Padding="14,14">
                        <Grid ColumnDefinitions="56,*" ColumnSpacing="14">

                            <!-- Store logo / initial circle -->
                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 26"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}">
                                <Image Source="{Binding Store.FullLogoUrl}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding Store.HasImage}" />
                                <Label Text="{Binding Store.NameInitial}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20"
                                       TextColor="{StaticResource Teal}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Store.HasImage, Converter={StaticResource InvertBool}}" />
                            </Border>

                            <!-- Store name + location + status chips -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding Store.Name}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding HeroLocationText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                                <!-- Open · Verified · Fast Pickup badges -->
                                <FlexLayout Direction="Row" Wrap="Wrap">
                                    <Border Margin="0,0,6,4" Padding="8,4"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MintSoft}, Dark={StaticResource DarkSoftTeal}}"
                                            Stroke="Transparent">
                                        <HorizontalStackLayout Spacing="5">
                                            <Ellipse Fill="#22C55E" WidthRequest="7" HeightRequest="7" VerticalOptions="Center" />
                                            <Label Text="{Binding Store.OpenStatusText}"
                                                   FontSize="11" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Teal}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Margin="0,0,6,4" Padding="8,4"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MintSoft}, Dark={StaticResource DarkSoftTeal}}"
                                            Stroke="Transparent"
                                            IsVisible="{Binding Store.IsVerified}">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="✓" FontSize="10" TextColor="{StaticResource Teal}" VerticalOptions="Center" />
                                            <Label Text="Verified" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource Teal}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Margin="0,0,6,4" Padding="8,4"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MintSoft}, Dark={StaticResource DarkSoftTeal}}"
                                            Stroke="Transparent"
                                            IsVisible="{Binding Store.FastPickup}">
                                        <Label Text="⚡ Fast Pickup"
                                               FontSize="11" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Teal}" />
                                    </Border>
                                </FlexLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                    <!-- ── Search bar ── -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 26"
                            HeightRequest="56"
                            Padding="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="16,0">
                            <Path Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                  StrokeThickness="2" StrokeLineCap="Round"
                                  WidthRequest="20" HeightRequest="20" VerticalOptions="Center"
                                  Data="M9,16 C5.1,16 2,12.9 2,9 C2,5.1 5.1,2 9,2 C12.9,2 16,5.1 16,9 C16,12.9 12.9,16 9,16 Z M14,14 L19,19" />
                            <Entry Grid.Column="1"
                                   BackgroundColor="Transparent"
                                   HeightRequest="44"
                                   FontSize="14"
                                   Text="{Binding ServiceSearchText}"
                                   Placeholder="Search services…"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" />
                        </Grid>
                    </Border>

                    <!-- ── Error banner ── -->
                    <Border BackgroundColor="{AppThemeBinding Light=#FFF1F0, Dark=#381D1D}"
                            Stroke="{AppThemeBinding Light=#FFB8B0, Dark=#783838}"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light=#C0392B, Dark=#FFB4AD}"
                               FontSize="13" />
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ══════════════════════════════════════════════════
                 GROUP HEADER  (e.g. "Wash & Clean", "Add-ons")
                 ══════════════════════════════════════════════════ -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ServiceGroup">
                    <Grid Padding="18,18,18,4">
                        <Label Text="{Binding GroupName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- ══════════════════════════════════════════════════
                 SERVICE CARD  (qty stepper · notes · line total)
                 ══════════════════════════════════════════════════ -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceCardViewModel">
                    <Grid Padding="18,5">
                        <Border Padding="16,14"
                                StrokeShape="RoundRectangle 22"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeThickness="1.2">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MintSoft}, Dark={StaticResource DarkSoftTeal}}" />
                                    <Setter Property="Stroke" Value="{StaticResource Teal}" />
                                    <Setter Property="StrokeThickness" Value="1.8" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="6">

                                <!-- Row 1: Service name  +  −/n/+ stepper -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Service.Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                           VerticalOptions="Center"
                                           MaxLines="2"
                                           LineBreakMode="WordWrap" />

                                    <!-- Stepper: outlined minus | count | filled-teal plus -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                                        <!-- Minus — grayed outline when qty=0, teal outline when qty>0 -->
                                        <Border WidthRequest="34" HeightRequest="34"
                                                StrokeShape="RoundRectangle 17"
                                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                                BackgroundColor="Transparent">
                                            <Border.Behaviors><behaviors:TapFeedbackBehavior /></Border.Behaviors>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource Teal}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiceSelectionViewModel}}, Path=DecrementServiceCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="−" FontSize="20" FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Teal}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <!-- Count label — muted when 0, primary when >0 -->
                                        <Label Text="{Binding CounterLabel}"
                                               WidthRequest="44"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Plus — always active teal fill -->
                                        <Border WidthRequest="34" HeightRequest="34"
                                                StrokeShape="RoundRectangle 17"
                                                Stroke="Transparent"
                                                BackgroundColor="{StaticResource Teal}">
                                            <Border.Behaviors><behaviors:TapFeedbackBehavior /></Border.Behaviors>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiceSelectionViewModel}}, Path=IncrementServiceCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="+" FontSize="20" FontFamily="OpenSansSemibold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Row 2: Short description (teal accent) -->
                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="{StaticResource Teal}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />

                                <!-- Row 3: Unit price -->
                                <Label Text="{Binding Service.PriceDisplay}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

                                <!-- Row 4: Notes entry + line-total chip — shown only when selected -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"
                                      Margin="0,4,0,0"
                                      IsVisible="{Binding IsSelected}">
                                    <Border Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
                                            Padding="10,2">
                                        <Entry Text="{Binding DraftItem.Notes}"
                                               Placeholder="Notes (e.g., separate whites)"
                                               FontSize="12"
                                               HeightRequest="34"
                                               BackgroundColor="Transparent"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource MintSoft}, Dark={StaticResource DarkSoftTeal}}"
                                            Padding="12,8"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding LineTotalDisplay}"
                                               TextColor="{StaticResource Teal}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14" />
                                    </Border>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- ══════════════════════════════════════════════════
                 EMPTY STATES
                 ══════════════════════════════════════════════════ -->
            <CollectionView.EmptyView>
                <Grid MinimumHeightRequest="300" Padding="28,20">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center"
                                         IsVisible="{Binding HasLoadError}">
                        <Image Source="vyron_app_icon_512.png" WidthRequest="62" HeightRequest="62" />
                        <Label Text="We couldn't load services"
                               FontFamily="OpenSansSemibold" FontSize="19"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label Text="Please check your connection and try again."
                               FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Button Text="Try Again" Command="{Binding LoadCommand}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center"
                                         IsVisible="{Binding IsServicesEmpty}">
                        <Border WidthRequest="76" HeightRequest="76" Stroke="Transparent" StrokeShape="RoundRectangle 38"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}">
                            <Image Source="vyron_icon_only.png" WidthRequest="42" HeightRequest="42"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="No services available yet"
                               FontFamily="OpenSansSemibold" FontSize="19" HorizontalTextAlignment="Center" />
                        <Label Text="This store has not published its laundry services.&#10;Please check another store or contact Vyron Support."
                               FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Button Text="Browse Other Stores" Command="{Binding BrowseStoresCommand}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center"
                                         IsVisible="{Binding IsServiceSearchEmpty}">
                        <Border WidthRequest="76" HeightRequest="76" Stroke="Transparent" StrokeShape="RoundRectangle 38"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}">
                            <Label Text="⌕" FontSize="32" TextColor="{StaticResource Teal}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="No matching services"
                               FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" />
                        <Label Text="Try a different search term."
                               FontSize="13" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>
                </Grid>
            </CollectionView.EmptyView>

            <!-- ══════════════════════════════════════════════════
                 FOOTER  (order summary — visible when cart has items)
                 ══════════════════════════════════════════════════ -->
            <CollectionView.Footer>
                <VerticalStackLayout Padding="18,16,18,24" Spacing="0"
                                     IsVisible="{Binding HasDraftItems}">
                    <Border BackgroundColor="{StaticResource Dark}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 22"
                            Padding="20,18">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Order summary"
                                   TextColor="White" FontFamily="OpenSansSemibold" FontSize="15" />
                            <BoxView HeightRequest="1" Color="#335C56" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Service subtotal" TextColor="#B8D7D2" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding TotalLaundryCost, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pickup fee" TextColor="#B8D7D2" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding PickupFee, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Delivery fee" TextColor="#B8D7D2" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding DeliveryFee, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#335C56" Margin="0,2" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Running total"
                                       TextColor="White" FontFamily="OpenSansSemibold" FontSize="14" />
                                <Label Grid.Column="1"
                                       Text="{Binding TotalEstimate, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontFamily="OpenSansSemibold" FontSize="18" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <!-- ══════════════════════════════════════════════════════
             STICKY CTA BAR — "Continue  ·  ₦X,XXX"
             Teal pill when cart has items; muted card bg when empty.
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="16,0,16,20"
                Padding="6"
                StrokeShape="RoundRectangle 34"
                Stroke="Transparent"
                BackgroundColor="{StaticResource Teal}">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding CanContinue}" Value="False">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" />
                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                </DataTrigger>
            </Border.Triggers>
            <Button Text="{Binding CtaButtonText}"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinue}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HeightRequest="54">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding CanContinue}" Value="False">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" />
                    </DataTrigger>
                </Button.Triggers>
                <Button.Behaviors><behaviors:TapFeedbackBehavior /></Button.Behaviors>
            </Button>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             LOADING OVERLAY  (blocks UI during load / navigate)
             ══════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="2"
              ZIndex="10"
              InputTransparent="False"
              IsVisible="{Binding IsOverlayVisible}"
              BackgroundColor="{StaticResource OverlayBg}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <Border WidthRequest="72" HeightRequest="72"
                        StrokeShape="RoundRectangle 36"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                        HorizontalOptions="Center">
                    <Image x:Name="LoadingIcon"
                           Source="vyron_icon_only.png"
                           WidthRequest="48" HeightRequest="48"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding LoaderText}"
                       FontFamily="OpenSansSemibold"
                       FontSize="14"
                       TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>

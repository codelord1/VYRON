<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:svc="clr-namespace:Vyron.CustomerApp.Services"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Orders.ServiceSelectionPage"
             x:DataType="vm:ServiceSelectionViewModel"
             Title="Select Services"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14" Padding="16">

                <!-- Store name -->
                <Label Text="{Binding Store.Name}"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       Margin="0,4,0,0" />

                <!-- Error -->
                <Border BackgroundColor="#FFF1F0" Stroke="#FFB8B0"
                        StrokeShape="RoundRectangle 10" Padding="12,10"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" FontSize="13" />
                </Border>

                <Label Text="Tap a service to add it to your order"
                       FontFamily="OpenSansSemibold" FontSize="15" />

                <!-- ── Available Services ── -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceCards}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceCardViewModel">
                            <Border StrokeShape="RoundRectangle 14"
                                    Padding="14,12">
                                <!-- Selected = teal border + light teal bg; unselected = gray border + white -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="#E8F8F5" />
                                        <Setter Property="Stroke" Value="{StaticResource Teal}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="False">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="Stroke" Value="#D0D0C8" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiceSelectionViewModel}}, Path=AddServiceCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Service.Name}" FontFamily="OpenSansSemibold" FontSize="15" />
                                        <Label Text="{Binding Service.Description}" FontSize="12"
                                               TextColor="{StaticResource Gray3}"
                                               IsVisible="{Binding Service.Description, Converter={StaticResource NotNullToBool}}" />
                                        <Label FontSize="12" TextColor="{StaticResource Gray3}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Service.MinChargeDisplay}" />
                                                    <Span Text="  ·  ~" />
                                                    <Span Text="{Binding Service.EstimatedHours, StringFormat='{0}h turnaround'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                                         HorizontalOptions="End" Spacing="2">
                                        <Label Text="{Binding Service.PriceDisplay}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               TextColor="{StaticResource Teal}"
                                               HorizontalOptions="End" />
                                        <!-- Show "✓ Added" when selected, "+ Add" when not -->
                                        <Label FontSize="11" HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="✓ Added" />
                                                    <Setter Property="TextColor" Value="{StaticResource Teal}" />
                                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsSelected}"
                                                             Value="False">
                                                    <Setter Property="Text" Value="＋ Add" />
                                                    <Setter Property="TextColor" Value="{StaticResource Gray3}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ── Your Order (selected items) ── -->
                <VerticalStackLayout IsVisible="{Binding HasDraftItems}" Spacing="10">

                    <BoxView HeightRequest="1" Color="#EDEDEA" Margin="0,8" />
                    <Label Text="🛒  Your Order"
                           FontFamily="OpenSansSemibold" FontSize="15" />

                    <!-- Draft item cards with +/- stepper controls -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftItems}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="svc:OrderDraftItem">
                                <Border BackgroundColor="White" Stroke="#EDEDEA"
                                        StrokeShape="RoundRectangle 12" Padding="14,10">
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Name row + remove button -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding ServiceName}"
                                                       FontFamily="OpenSansSemibold" FontSize="14" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Border BackgroundColor="#E5F8F2"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="8,3">
                                                        <Label Text="{Binding PricingModeLabel}"
                                                               FontSize="11"
                                                               FontFamily="OpenSansSemibold"
                                                               TextColor="{StaticResource Teal}" />
                                                    </Border>
                                                    <Label Text="{Binding PriceDisplay}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Gray3}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    FontSize="13"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#E74C3C"
                                                    Padding="10,2"
                                                    VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ServiceSelectionViewModel}}, Path=RemoveItemCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- Pricing-mode specific controls -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                            <!-- Weight stepper: PerKg only -->
                                            <VerticalStackLayout IsVisible="{Binding IsPerKg}">
                                                <Label Text="Weight (kg)"
                                                       FontSize="11" FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource Gray3}"
                                                       Margin="0,0,0,4" />
                                                <Grid ColumnDefinitions="36,*,36">
                                                    <Button Text="−"
                                                            FontSize="16"
                                                            BackgroundColor="{StaticResource Bg}"
                                                            TextColor="{StaticResource Teal}"
                                                            Padding="0"
                                                            HeightRequest="36"
                                                            Command="{Binding DecrementWeightCommand}" />
                                                    <Border Grid.Column="1"
                                                            BackgroundColor="White"
                                                            Stroke="#D0D0C8"
                                                            StrokeShape="RoundRectangle 6">
                                                        <Label Text="{Binding WeightText}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalOptions="Center"
                                                               Margin="4,4" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Text="＋"
                                                            FontSize="16"
                                                            BackgroundColor="{StaticResource Bg}"
                                                            TextColor="{StaticResource Teal}"
                                                            Padding="0"
                                                            HeightRequest="36"
                                                            Command="{Binding IncrementWeightCommand}" />
                                                </Grid>
                                            </VerticalStackLayout>

                                            <!-- Pieces stepper: PerItem only -->
                                            <VerticalStackLayout IsVisible="{Binding IsPerItem}">
                                                <Label Text="Pieces"
                                                       FontSize="11" FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource Gray3}"
                                                       Margin="0,0,0,4" />
                                                <Grid ColumnDefinitions="36,*,36">
                                                    <Button Text="−"
                                                            FontSize="16"
                                                            BackgroundColor="{StaticResource Bg}"
                                                            TextColor="{StaticResource Teal}"
                                                            Padding="0"
                                                            HeightRequest="36"
                                                            Command="{Binding DecrementPiecesCommand}" />
                                                    <Border Grid.Column="1"
                                                            BackgroundColor="White"
                                                            Stroke="#D0D0C8"
                                                            StrokeShape="RoundRectangle 6">
                                                        <Label Text="{Binding PiecesText}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalOptions="Center"
                                                               Margin="4,4" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Text="＋"
                                                            FontSize="16"
                                                            BackgroundColor="{StaticResource Bg}"
                                                            TextColor="{StaticResource Teal}"
                                                            Padding="0"
                                                            HeightRequest="36"
                                                            Command="{Binding IncrementPiecesCommand}" />
                                                </Grid>
                                            </VerticalStackLayout>

                                            <!-- Fixed service: no customer quantity control -->
                                            <VerticalStackLayout IsVisible="{Binding IsFixed}"
                                                                 VerticalOptions="Center">
                                                <Label Text="Fixed price"
                                                       FontSize="11"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource Gray3}" />
                                                <Label Text="No weight or pieces needed"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray3}" />
                                            </VerticalStackLayout>

                                            <!-- Line total -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                  VerticalOptions="Center"
                                                                  HorizontalOptions="End">
                                                <Label Text="{Binding LineTotalDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16"
                                                       TextColor="{StaticResource Teal}"
                                                       HorizontalOptions="End" />
                                                <Label Text="{Binding PriceDisplay}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource Gray3}"
                                                       HorizontalOptions="End" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label Text="{Binding MinimumChargeDisplay}"
                                               IsVisible="{Binding HasMinimumCharge}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray3}" />

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Totals card -->
                    <Border BackgroundColor="{StaticResource Dark}"
                            StrokeShape="RoundRectangle 14"
                            Padding="18,14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="💰  Price Estimate"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14" />
                            <BoxView HeightRequest="1" Color="#333" />
                            <Label Text="Order items"
                                   TextColor="#B8D7D2"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftItems}" Spacing="5">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="svc:OrderDraftItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding LineSummary}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding LineTotalDisplay}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontFamily="OpenSansSemibold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="#333" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Laundry cost" TextColor="{StaticResource Gray3}" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding TotalLaundryCost, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pickup fee" TextColor="{StaticResource Gray3}" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding PickupFee, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Delivery fee" TextColor="{StaticResource Gray3}" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding DeliveryFee, StringFormat='₦{0:N0}'}"
                                       TextColor="White" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Total estimate"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding TotalEstimate, StringFormat='â‚¦{0:N0}'}"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#444" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="💳 Pay now (pickup fee)"
                                       TextColor="{StaticResource Teal}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding AmountDueNow, StringFormat='₦{0:N0}'}"
                                       TextColor="{StaticResource Teal}"
                                       FontFamily="OpenSansSemibold" FontSize="15" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="⏳ Balance on delivery"
                                       TextColor="{StaticResource Gray3}" FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding BalanceDueLater, StringFormat='₦{0:N0}'}"
                                       TextColor="{StaticResource Gray3}" FontSize="13" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Label Text="* Pickup fee may vary based on your distance from the store."
                                   TextColor="#8BA8A4"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom CTA -->
        <Border Grid.Row="1" BackgroundColor="White" Stroke="#EDEDEA" Padding="16,12">
            <Button Text="Continue to Order Details →"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
        </Border>

    </Grid>
</ContentPage>

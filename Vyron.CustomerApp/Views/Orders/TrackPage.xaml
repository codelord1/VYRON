<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Orders.TrackPage"
             x:DataType="vm:TrackViewModel"
             Title="Track"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource Bg}"
                Stroke="{StaticResource CardStroke}"
                StrokeThickness="0,0,0,1"
                Padding="18,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border BackgroundColor="{StaticResource Mint}"
                        WidthRequest="40"
                        HeightRequest="40"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 20">
                    <Label Text="Back"
                           FontSize="11"
                           TextColor="{StaticResource TealDark}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Text="{Binding ActiveOrder.OrderNumber, StringFormat='Order {0}'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       VerticalOptions="Center" />
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource Mint}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 14"
                        Padding="10,5"
                        VerticalOptions="Center">
                    <Label Text="LIVE"
                           TextColor="{StaticResource TealDark}"
                           FontSize="11"
                           FontFamily="OpenSansSemibold" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource Teal}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   Margin="0,40" />

                <VerticalStackLayout IsVisible="{Binding HasActiveOrder}" Spacing="16">
                    <Border BackgroundColor="{StaticResource TealDark}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 26"
                            Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Border BackgroundColor="#2B9278"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,5"
                                    HorizontalOptions="Start">
                                <Label Text="{Binding ActiveOrder.StatusName, StringFormat='STAGE: {0}'}"
                                       TextColor="#D9F8EC"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold" />
                            </Border>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ActiveOrder.StatusDescription}"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="25" />
                                <Label Text="{Binding ActiveOrder.StatusSubtitle}"
                                       TextColor="#D9F8EC"
                                       FontSize="14" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border BackgroundColor="#24926F"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="14">
                                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                        <Border BackgroundColor="White"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 19">
                                            <Label Text="ETA"
                                                   FontSize="10"
                                                   TextColor="{StaticResource TealDark}"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="ETA" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                                            <Label Text="Soon" TextColor="#D9F8EC" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1"
                                        BackgroundColor="#24926F"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="14">
                                    <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                        <Border BackgroundColor="White"
                                                WidthRequest="38"
                                                HeightRequest="38"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 19">
                                            <Label Text="Pin"
                                                   FontSize="10"
                                                   TextColor="{StaticResource TealDark}"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Distance" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                                            <Label Text="Tracking" TextColor="#D9F8EC" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#D8F5EA"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            HeightRequest="176"
                            Padding="18">
                        <Grid>
                            <Path Stroke="{StaticResource TealDark}"
                                  StrokeThickness="3"
                                  StrokeDashArray="4,5"
                                  Data="M 10 120 C 80 40, 160 150, 300 36"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />
                            <Border BackgroundColor="White"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="12,7"
                                    VerticalOptions="End"
                                    HorizontalOptions="Start">
                                <Label Text="LIVE TRACKING"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource Gray5}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            IsVisible="{Binding ActiveOrder.Rider, Converter={StaticResource NotNullToBool}}">
                        <Grid ColumnDefinitions="54,*,Auto,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource Mint}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 24">
                                <Label Text="{Binding ActiveOrder.Rider.FullName, Converter={StaticResource InitialsConverter}}"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource TealDark}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ActiveOrder.Rider.FullName}" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="{Binding ActiveOrder.Rider.VehiclePlate, StringFormat='Bike - {0}'}" FontSize="12" TextColor="{StaticResource Gray3}" />
                                <Label Text="{Binding ActiveOrder.Rider.VehicleType}" FontSize="12" TextColor="{StaticResource Gray3}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Chat"
                                    Command="{Binding MessageRiderCommand}"
                                    BackgroundColor="{StaticResource Mint}"
                                    TextColor="{StaticResource TealDark}"
                                    WidthRequest="54"
                                    HeightRequest="44"
                                    Padding="0"
                                    FontSize="12" />
                            <Button Grid.Column="3"
                                    Text="Call"
                                    Command="{Binding CallRiderCommand}"
                                    WidthRequest="54"
                                    HeightRequest="44"
                                    Padding="0"
                                    FontSize="12" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource Mint}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 24">
                                <Label Text="Store"
                                       FontSize="10"
                                       TextColor="{StaticResource TealDark}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ActiveOrder.Store.Name}" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="{Binding ActiveOrder.StatusSubtitle}" FontSize="12" TextColor="{StaticResource Gray3}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Call"
                                    Command="{Binding CallStoreCommand}"
                                    BackgroundColor="{StaticResource Mint}"
                                    TextColor="{StaticResource TealDark}"
                                    WidthRequest="58"
                                    HeightRequest="44"
                                    Padding="0"
                                    FontSize="12" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Order timeline"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   Margin="0,0,0,16" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProgressSteps}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OrderProgressStep">
                                        <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="24"
                                                    HeightRequest="24"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 12"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsFuture}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsFuture}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource TealDark}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="✓"
                                                       TextColor="White"
                                                       FontSize="11"
                                                       FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <BoxView Grid.Row="1"
                                                     WidthRequest="2"
                                                     HeightRequest="30"
                                                     Color="{StaticResource TealDark}"
                                                     HorizontalOptions="Center"
                                                     IsVisible="{Binding HasConnector}" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="0,1,0,0">
                                                <Label Text="{Binding Label}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14" />
                                                <Label Text="{Binding Timestamp}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray3}"
                                                       IsVisible="{Binding Timestamp, Converter={StaticResource NotNullToBool}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="28,80">
                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="76" HeightRequest="76" Stroke="Transparent" StrokeShape="RoundRectangle 38">
                        <Label Text="Track" FontSize="12" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="No active orders"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <Label Text="When you place an order, its live status will appear here."
                           FontSize="13"
                           TextColor="{StaticResource Gray3}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Browse Stores"
                            Command="{Binding GoToStoresCommand}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="18,12"
              BackgroundColor="White"
              IsVisible="{Binding HasActiveOrder}">
            <Button Text="Report issue"
                    IsEnabled="False"
                    BackgroundColor="White"
                    BorderColor="#FF9FA6"
                    BorderWidth="1"
                    TextColor="{StaticResource Danger}" />
            <Button Grid.Column="1"
                    Text="View details"
                    Command="{Binding ViewOrderCommand}" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             x:Class="Vyron.CustomerApp.Views.Orders.OrderDetailsPage"
             x:DataType="vm:OrderDetailsViewModel"
             Title="{Binding Order.OrderNumber, FallbackValue='Order Details'}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource Teal}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" Margin="0,40" />

                <Border BackgroundColor="#FFF4F3"
                        Stroke="#FFD4D1"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding ErrorMessage}" TextColor="#C73535" FontSize="13" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Try Again" Command="{Binding LoadCommand}" HeightRequest="34" Padding="12,0" FontSize="12">
                            <Button.Behaviors>
                                <behaviors:TapFeedbackBehavior />
                            </Button.Behaviors>
                        </Button>
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsNotBusy}" Spacing="14">

                    <!-- Status hero -->
                    <Border BackgroundColor="{StaticResource Dark}"
                            StrokeShape="RoundRectangle 16" Padding="20,16">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Order.OrderNumber}"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.StatusEmoji}"
                                       FontSize="24" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding Order.StatusName}"
                                   TextColor="{StaticResource Teal}"
                                   FontFamily="OpenSansSemibold" FontSize="16" />
                            <Label Text="{Binding Order.PaymentStateName}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Store & services -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Store &amp; Services"
                                   FontFamily="OpenSansSemibold" FontSize="14" />
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                <Border BackgroundColor="{StaticResource Mint}"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 18">
                                    <Image Source="{Binding Order.Store.LogoUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding Order.Store.HasLogo}" />
                                    <Label Text="{Binding Order.Store.Name, Converter={StaticResource InitialsConverter}}"
                                           TextColor="{StaticResource TealDark}"
                                           FontFamily="OpenSansSemibold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding Order.Store.HasLogo, Converter={StaticResource InvertBool}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Order.Store.Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15" />
                                    <Label Text="{Binding Order.Service.Name}"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Order.Items}" Spacing="8"
                                                 IsVisible="{Binding Order.HasItems}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:OrderItemDto">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding ServiceName}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13" />
                                                <Label Text="{Binding QtyDisplay}"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                       FontSize="12" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding LineTotalDisplay}"
                                                   TextColor="{StaticResource Teal}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Pricing -->
                    <Border BackgroundColor="{StaticResource Dark}" Stroke="#202C2C"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Order Summary" TextColor="White" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Estimated laundry" FontSize="13" TextColor="#B8D7D2" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.EstimatedLaundryCost, StringFormat='₦{0:N0}'}"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pickup fee" FontSize="13" TextColor="#B8D7D2" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.PickupFeeAmount, StringFormat='₦{0:N0}'}"
                                       TextColor="White"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Pickup payment" FontSize="13" TextColor="#B8D7D2" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.PickupPaymentMethodDisplay}"
                                       TextColor="{StaticResource Teal}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Balance due" FontSize="13" TextColor="#B8D7D2" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.BalanceAmount, StringFormat='₦{0:N0}'}"
                                       FontFamily="OpenSansSemibold" FontSize="13"
                                       TextColor="{StaticResource Teal}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Rider info -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Pickup Rider"
                                   FontFamily="OpenSansSemibold" FontSize="14" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Order.HasPickupRider}">
                                <Label Text="Name" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Label Grid.Column="1" Text="{Binding Order.Rider.FullName}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Order.HasPickupRider}">
                                <Label Text="Vehicle" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.Rider.VehicleDisplay}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Label Text="Pickup rider not assigned yet"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   FontSize="13"
                                   IsVisible="{Binding Order.HasPickupRider, Converter={StaticResource InvertBool}}" />
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" Margin="0,4" />
                            <Label Text="Delivery Rider" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Order.HasDeliveryRider}">
                                <Label Text="Name" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Label Grid.Column="1" Text="{Binding Order.DeliveryRider.FullName}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Order.HasDeliveryRider}">
                                <Label Text="Vehicle" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Order.DeliveryRider.VehicleDisplay}"
                                       FontFamily="OpenSansSemibold" FontSize="13" />
                            </Grid>
                            <Label Text="Delivery rider not assigned yet"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   FontSize="13"
                                   IsVisible="{Binding Order.HasDeliveryRider, Converter={StaticResource InvertBool}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Addresses -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Addresses" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Pickup" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            <Label Text="{Binding Order.PickupAddress}" FontSize="13" />
                            <Label Text="Delivery" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                            <Label Text="{Binding Order.DeliveryAddress}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Status History -->
                    <Label Text="Timeline" FontFamily="OpenSansSemibold" FontSize="14" Margin="4,4,4,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Order.StatusHistory}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:StatusHistoryDto">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource Teal}"
                                            WidthRequest="8" HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            VerticalOptions="Start"
                                            Margin="0,6,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding StatusName}"
                                               FontFamily="OpenSansSemibold" FontSize="13" />
                                        <Label Text="{Binding Note}"
                                               FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               IsVisible="{Binding Note, Converter={StaticResource NotNullToBool}}" />
                                        <Label Text="{Binding ChangedAt, StringFormat='{0:MMM dd, HH:mm}'}"
                                               FontSize="11" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

        <!-- Action buttons row -->
        <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" Padding="16,12">
            <VerticalStackLayout Spacing="8">
                <Button Text="Reorder"
                        Command="{Binding ReorderCommand}"
                        IsEnabled="{Binding IsNotReordering}"
                        IsVisible="{Binding Order, Converter={StaticResource NotNullToBool}}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
                <ActivityIndicator IsRunning="{Binding IsReordering}"
                                   IsVisible="{Binding IsReordering}"
                                   Color="{StaticResource Teal}"
                                   HorizontalOptions="Center" />
                <Button Text="Pay Pickup Fee"
                        Command="{Binding PayPickupFeeCommand}"
                        IsVisible="{Binding Order.CanPayPickupFee}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
                <Button Text="Pay Balance"
                        Command="{Binding PayBalanceCommand}"
                        IsVisible="{Binding Order.CanPayBalance}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
                <Button Text="Leave Review"
                        Command="{Binding AddReviewCommand}"
                        IsVisible="{Binding Order.CanReview}"
                        BackgroundColor="{StaticResource Teal}">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
                <Button Text="Raise Dispute"
                        Command="{Binding RaiseDisputeCommand}"
                        IsVisible="{Binding Order.CanDispute}"
                        BackgroundColor="#C0392B"
                        FontSize="13" HeightRequest="40">
                    <Button.Behaviors>
                        <behaviors:TapFeedbackBehavior />
                    </Button.Behaviors>
                </Button>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Orders.OrderSuccessPage"
             x:DataType="vm:OrderSuccessViewModel"
             Title="Order Placed"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,40" Spacing="20" HorizontalOptions="Fill">

            <Border BackgroundColor="{DynamicResource Mint}"
                    WidthRequest="96"
                    HeightRequest="96"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 48"
                    HorizontalOptions="Center">
                <Label Text="🎉"
                       FontSize="44"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <Label Text="Order placed successfully"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Your pickup request has been created."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                    Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20,16"
                    IsVisible="{Binding Order, Converter={StaticResource NotNullToBool}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Order Number" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Label Grid.Column="1" Text="{Binding Order.OrderNumber}"
                               FontFamily="OpenSansSemibold" FontSize="14" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Store" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Label Grid.Column="1" Text="{Binding Order.Store.Name}"
                               FontFamily="OpenSansSemibold" FontSize="14" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                    <Border BackgroundColor="{DynamicResource Teal}"
                            StrokeShape="RoundRectangle 12"
                            Padding="16,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Pay Pickup Fee Now"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding Order.PickupFeeAmount, StringFormat='₦{0:N0}'}"
                                   TextColor="White"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   HorizontalOptions="Center" />
                            <Label Text="Pay this to proceed to rider assignment"
                                   TextColor="#D0FFF5"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Balance on delivery" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        <Label Grid.Column="1"
                               Text="{Binding Order.BalanceAmount, StringFormat='₦{0:N0}'}"
                               FontFamily="OpenSansSemibold" FontSize="13" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Pay Pickup Fee"
                    Command="{Binding PayPickupFeeCommand}"
                    IsEnabled="{Binding IsNotBusy}">
                <Button.Behaviors>
                    <behaviors:TapFeedbackBehavior />
                </Button.Behaviors>
            </Button>

            <Button Text="View All Orders"
                    Command="{Binding GoToOrdersCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Teal}"
                    FontSize="14">
                <Button.Behaviors>
                    <behaviors:TapFeedbackBehavior />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

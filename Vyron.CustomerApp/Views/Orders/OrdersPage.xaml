<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Orders.OrdersPage"
             x:Name="ThisPage"
             x:DataType="vm:OrdersViewModel"
             Title="My Orders"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid>
    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 IsEnabled="{Binding IsNotOpeningOrder}">
        <CollectionView ItemsSource="{Binding FilteredOrders}"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Padding="20,18,20,16" Spacing="18">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="My orders"
                               FontFamily="OpenSansSemibold"
                               FontSize="20" />
                        <Label Text="{Binding Orders_.Count, StringFormat='{0} total orders'}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFF4F3"
                            Stroke="#FFD4D1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C73535"
                               FontSize="13" />
                    </Border>

                    <Border BackgroundColor="{StaticResource Mint}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 22"
                            Padding="4">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="14,10">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetStatusTabCommand}" CommandParameter="Active" />
                                </Border.GestureRecognizers>
                                <Label Text="Active" HorizontalTextAlignment="Center" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource TealDark}" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="14,10">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetStatusTabCommand}" CommandParameter="Completed" />
                                </Border.GestureRecognizers>
                                <Label Text="Completed" HorizontalTextAlignment="Center" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="14,10">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetStatusTabCommand}" CommandParameter="Cancelled" />
                                </Border.GestureRecognizers>
                                <Label Text="Cancelled" HorizontalTextAlignment="Center" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="40,80">
                    <Border BackgroundColor="{StaticResource Mint}"
                            WidthRequest="76"
                            HeightRequest="76"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 38">
                        <Image Source="vyron_icon_only.png"
                               HeightRequest="42"
                               WidthRequest="42"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="No orders yet"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Browse stores and place your first laundry order."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:OrderDto">
                    <Grid Padding="20,7">
                        <Grid.Behaviors>
                            <behaviors:TapFeedbackBehavior />
                        </Grid.Behaviors>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectOrderCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeShape="RoundRectangle 24"
                                Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{StaticResource Mint}"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 18">
                                        <Image Source="{Binding Store.LogoUrl}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding Store.HasLogo}" />
                                        <Label Text="{Binding Store.Name, Converter={StaticResource InitialsConverter}}"
                                               FontSize="12"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource TealDark}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Store.HasLogo, Converter={StaticResource InvertBool}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Store.Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding OrderNumber, StringFormat='#{0}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM d, h:mm tt}'}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2"
                                            BackgroundColor="{StaticResource Mint}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,6"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding StatusName}"
                                               FontSize="11"
                                               TextColor="{StaticResource TealDark}"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TotalEstimate, StringFormat='₦{0:N0}'}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16" />
                                        <Label Text="Tap card to view details"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            BackgroundColor="{StaticResource Teal}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 18"
                                            Padding="16,9"
                                            VerticalOptions="Center">
                                        <Label Text="Track"
                                               TextColor="White"
                                               FontSize="12"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
    <Grid BackgroundColor="#66F4FAF7"
          IsVisible="{Binding IsOpeningOrder}">
        <VerticalStackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="10">
            <ActivityIndicator IsRunning="{Binding IsOpeningOrder}"
                               Color="{StaticResource Teal}" />
            <Label Text="Opening order..."
                   TextColor="{StaticResource TealDark}"
                   FontSize="13"
                   FontFamily="OpenSansSemibold" />
        </VerticalStackLayout>
    </Grid>
    </Grid>
</ContentPage>


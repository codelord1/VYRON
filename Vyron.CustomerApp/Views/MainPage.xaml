<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             x:Class="Vyron.CustomerApp.Views.MainPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,30,24,34">
        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout x:Name="DotsHost" Spacing="6" VerticalOptions="Center">
                <BoxView x:Name="Dot0" WidthRequest="24" HeightRequest="5" CornerRadius="3" Color="{StaticResource TealDark}" />
                <BoxView x:Name="Dot1" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                <BoxView x:Name="Dot2" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                <BoxView x:Name="Dot3" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="Skip"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                   FontSize="14"
                   VerticalOptions="Center">
                <Label.Behaviors>
                    <behaviors:TapFeedbackBehavior />
                </Label.Behaviors>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSkipTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="34"
                             VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource Mint}"
                    WidthRequest="256"
                    HeightRequest="256"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 48"
                    HorizontalOptions="Center">
                <Border BackgroundColor="#EAFBF4"
                        WidthRequest="178"
                        HeightRequest="178"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 42"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                            WidthRequest="112"
                            HeightRequest="112"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Grid>
                            <Path x:Name="TruckIcon" Stroke="{StaticResource TealDark}" StrokeThickness="4" StrokeLineCap="Round" StrokeLineJoin="Round" Data="M22,54 L22,36 L54,36 L54,54 M54,42 L66,42 L76,54 L76,62 L68,62 M34,62 L58,62 M29,62 A6,6 0 1 0 29,74 A6,6 0 1 0 29,62 M64,62 A6,6 0 1 0 64,74 A6,6 0 1 0 64,62" />
                            <Path x:Name="PinIcon" Stroke="{StaticResource TealDark}" StrokeThickness="4" StrokeLineCap="Round" StrokeLineJoin="Round" IsVisible="False" Data="M56,76 C56,76 76,56 76,36 A20,20 0 1 0 36,36 C36,56 56,76 56,76 Z M56,43 A7,7 0 1 0 56,29 A7,7 0 1 0 56,43" />
                            <Path x:Name="SparkIcon" Stroke="{StaticResource TealDark}" StrokeThickness="4" StrokeLineCap="Round" StrokeLineJoin="Round" IsVisible="False" Data="M24,58 C36,48 45,70 58,54 M60,22 L66,36 L80,42 L66,48 L60,62 L54,48 L40,42 L54,36 Z M30,28 L32,34 M26,32 L36,30" />
                            <Path x:Name="ShirtIcon" Stroke="{StaticResource TealDark}" StrokeThickness="4" StrokeLineCap="Round" StrokeLineJoin="Round" IsVisible="False" Data="M34,34 L48,26 L56,34 L64,26 L78,34 L70,44 L70,76 L42,76 L42,44 Z" />
                        </Grid>
                    </Border>
                </Border>
            </Border>

            <VerticalStackLayout Spacing="14">
                <Label x:Name="TitleLabel"
                       Text="Book laundry pickup from your phone"
                       FontFamily="OpenSansSemibold"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="SubtitleLabel"
                       Text="Schedule pickup in under a minute. No more hauling baskets across town."
                       FontSize="15"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalTextAlignment="Center"
                       Margin="8,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <Button x:Name="BackButton"
                    Text="‹"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                    FontSize="28"
                    WidthRequest="62"
                    IsVisible="False">
                <Button.Behaviors>
                    <behaviors:TapFeedbackBehavior />
                </Button.Behaviors>
            </Button>
            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Text="Next"
                    Clicked="OnNextClicked">
                <Button.Behaviors>
                    <behaviors:TapFeedbackBehavior />
                </Button.Behaviors>
            </Button>
        </Grid>
    </Grid>
</ContentPage>

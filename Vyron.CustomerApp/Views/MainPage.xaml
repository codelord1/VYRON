<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vyron.CustomerApp.Views.MainPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,30,24,34">
        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout x:Name="DotsHost" Spacing="6" VerticalOptions="Center">
                <BoxView x:Name="Dot0" WidthRequest="24" HeightRequest="5" CornerRadius="3" Color="{StaticResource TealDark}" />
                <BoxView x:Name="Dot1" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{StaticResource CardStroke}" />
                <BoxView x:Name="Dot2" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{StaticResource CardStroke}" />
                <BoxView x:Name="Dot3" WidthRequest="5" HeightRequest="5" CornerRadius="3" Color="{StaticResource CardStroke}" />
            </HorizontalStackLayout>
            <Label Grid.Column="1"
                   Text="Skip"
                   TextColor="{StaticResource Gray5}"
                   FontSize="14"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSkipTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="34"
                             VerticalOptions="Center">
            <Border BackgroundColor="{StaticResource Mint}"
                    WidthRequest="256"
                    HeightRequest="256"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 48"
                    HorizontalOptions="Center">
                <Border BackgroundColor="#EAFBF4"
                        WidthRequest="178"
                        HeightRequest="178"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 42"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border BackgroundColor="White"
                            WidthRequest="112"
                            HeightRequest="112"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label x:Name="IconLabel"
                               Text="Truck"
                               FontSize="15"
                               TextColor="{StaticResource TealDark}"
                               FontFamily="OpenSansSemibold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Border>
            </Border>

            <VerticalStackLayout Spacing="14">
                <Label x:Name="TitleLabel"
                       Text="Book laundry pickup from your phone"
                       FontFamily="OpenSansSemibold"
                       FontSize="24"
                       TextColor="{StaticResource Gray5}"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="SubtitleLabel"
                       Text="Schedule pickup in under a minute. No more hauling baskets across town."
                       FontSize="15"
                       TextColor="{StaticResource Gray3}"
                       HorizontalTextAlignment="Center"
                       Margin="8,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <Button x:Name="BackButton"
                    Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Gray5}"
                    WidthRequest="62"
                    IsVisible="False" />
            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Text="Next"
                    Clicked="OnNextClicked" />
        </Grid>
    </Grid>
</ContentPage>

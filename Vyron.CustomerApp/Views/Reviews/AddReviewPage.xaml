<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Reviews.AddReviewPage"
             x:DataType="vm:AddReviewViewModel"
             Title="Leave a Review"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Success -->
            <VerticalStackLayout IsVisible="{Binding Submitted}" Spacing="16">
                <Label Text="⭐" FontSize="56" HorizontalOptions="Center" />
                <Label Text="Review Submitted!" FontFamily="OpenSansSemibold" FontSize="22"
                       HorizontalOptions="Center" />
                <Label Text="{Binding SuccessMessage}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="← Back to Orders"
                        Clicked="OnBackToOrders" />
            </VerticalStackLayout>

            <!-- Form -->
            <VerticalStackLayout IsVisible="{Binding Submitted, Converter={StaticResource InvertBool}}"
                                 Spacing="16">

                <Label Text="How was your experience?"
                       FontFamily="OpenSansSemibold" FontSize="18" />

                <Border BackgroundColor="#FFF1F0" Stroke="#FFB8B0"
                        StrokeShape="RoundRectangle 10" Padding="12,10"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" FontSize="13" />
                </Border>

                <!-- Star rating -->
                <Label Text="{Binding StarsDisplay}"
                       FontSize="40"
                       TextColor="#FFC107"
                       HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="1" BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                            Clicked="OnStarTap" CommandParameter="1"
                            HeightRequest="44" />
                    <Button Grid.Column="1" Text="2" BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                            Clicked="OnStarTap" CommandParameter="2"
                            HeightRequest="44" />
                    <Button Grid.Column="2" Text="3" BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                            Clicked="OnStarTap" CommandParameter="3"
                            HeightRequest="44" />
                    <Button Grid.Column="3" Text="4" BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}"
                            TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                            Clicked="OnStarTap" CommandParameter="4"
                            HeightRequest="44" />
                    <Button Grid.Column="4" Text="5" BackgroundColor="{StaticResource Teal}"
                            TextColor="White"
                            Clicked="OnStarTap" CommandParameter="5"
                            HeightRequest="44" />
                </Grid>

                <Label Text="Your Comment (optional)"
                       FontFamily="OpenSansSemibold" FontSize="14" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12">
                    <Editor Placeholder="Tell us what you liked or disliked..."
                            Text="{Binding Comment}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"
                            BackgroundColor="Transparent"
                            Margin="12,8" />
                </Border>

                <Button Text="Submit Review"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Stores.StoresPage"
             x:Name="ThisPage"
             x:DataType="vm:StoresViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding StoreItems}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,18,20,14" Spacing="16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nearby stores" FontFamily="OpenSansSemibold" FontSize="20" />
                        <Label Text="Verified laundry stores near you" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFF4F3"
                            Stroke="#FFD4D1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#C73535"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Try Again"
                                    Command="{Binding LoadCommand}"
                                    HeightRequest="34"
                                    Padding="12,0"
                                    FontSize="12">
                                <Button.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Button.Behaviors>
                            </Button>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 24" HeightRequest="60">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="16,0">
                            <Label Text="SEARCH" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Search store, service, area" Text="{Binding SearchText}" ReturnCommand="{Binding SearchCommand}" ReturnType="Search" />
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource Mint}" Stroke="Transparent" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                <Path Stroke="{StaticResource TealDark}" StrokeThickness="2" StrokeLineCap="Round" Data="M14,18 L34,18 M20,14 L20,22 M14,30 L34,30 M28,26 L28,34" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}" StrokeShape="RoundRectangle 18" Padding="16,9">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Label Text="Nearest" FontSize="12" TextColor="White" FontFamily="OpenSansSemibold" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 18" Padding="16,9">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Label Text="Top Rated" FontSize="12" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="toprated" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 18" Padding="16,9">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Label Text="Fastest" FontSize="12" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="fast" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 18" Padding="16,9">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Label Text="Cheapest" FontSize="12" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="cheapest" />
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="40,80">
                    <Border BackgroundColor="{DynamicResource Mint}" WidthRequest="76" HeightRequest="76" Stroke="Transparent" StrokeShape="RoundRectangle 38">
                        <Image Source="vyron_icon_only.png"
                               HeightRequest="42"
                               WidthRequest="42"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding EmptyTitle}" FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptySubtitle}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:StoreListItemDto">
                    <Grid Padding="20,8">
                        <Grid.Behaviors>
                            <behaviors:TapFeedbackBehavior />
                        </Grid.Behaviors>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 24">
                            <Grid RowDefinitions="128,Auto">
                                <Grid BackgroundColor="#0AA37F">
                                    <Label Text="{Binding NameInitial}" FontFamily="OpenSansSemibold" FontSize="46" TextColor="#BDF5E5" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image Source="{Binding FullLogoUrl}" Aspect="AspectFill" IsVisible="{Binding HasLogo}" />
                                    <HorizontalStackLayout Margin="14" Spacing="8" VerticalOptions="Start">
                                        <Border BackgroundColor="#BDEEDB" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,4">
                                            <Label Text="{Binding OpenStatusText}" FontSize="11" TextColor="{StaticResource TealDark}" FontFamily="OpenSansSemibold" />
                                        </Border>
                                        <Border BackgroundColor="#BDEEDB" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,4" IsVisible="{Binding BadgeText, Converter={StaticResource NotEmptyBool}}">
                                            <Label Text="{Binding BadgeText}" FontSize="11" TextColor="{StaticResource TealDark}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Border BackgroundColor="#0A5D50" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="10,5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,14,14,0">
                                        <Label Text="{Binding RatingDisplay}" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Padding="16,14,16,16" Spacing="8">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding StartingFromText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="{Binding Area}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding EstimatedTimeDisplay}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        <Label Text="{Binding PickupFeeDisplay}" FontSize="12" TextColor="{StaticResource TealDark}" />
                                        <Label Text="{Binding DeliveryFeeDisplay}" FontSize="12" TextColor="{StaticResource TealDark}" />
                                    </HorizontalStackLayout>
                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding StartingFromText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource Teal}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="16,9">
                                            <Label Text="View Store" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectStoreCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>


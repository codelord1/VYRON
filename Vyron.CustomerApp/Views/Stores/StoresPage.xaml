<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Stores.StoresPage"
             x:Name="ThisPage"
             x:DataType="vm:StoresViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding StoreItems}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20,18,20,16" Spacing="18">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Nearby stores"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        <Label Text="{Binding StoresSubtitle}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFF4F3, Dark=#381D1D}"
                            Stroke="{AppThemeBinding Light=#FFD4D1, Dark=#783838}"
                            StrokeShape="RoundRectangle 18"
                            Padding="14,12"
                            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{AppThemeBinding Light=#C73535, Dark=#FFB4AD}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Try Again"
                                    Command="{Binding LoadCommand}"
                                    HeightRequest="34"
                                    Padding="12,0"
                                    FontSize="12">
                                <Button.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Button.Behaviors>
                            </Button>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeShape="RoundRectangle 26"
                            HeightRequest="62"
                            Padding="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="17,0">
                            <Path Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeLineJoin="Round"
                                  WidthRequest="20"
                                  HeightRequest="20"
                                  VerticalOptions="Center"
                                  Data="M9,16 C5.1,16 2,12.9 2,9 C2,5.1 5.1,2 9,2 C12.9,2 16,5.1 16,9 C16,12.9 12.9,16 9,16 Z M14,14 L19,19" />
                            <Entry Grid.Column="1"
                                   Placeholder="Search store, service, area"
                                   Text="{Binding SearchText}"
                                   ReturnCommand="{Binding SearchCommand}"
                                   ReturnType="Search"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   HeightRequest="44"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" />
                            <Border Grid.Column="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 21"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    VerticalOptions="Center">
                                <Border.Behaviors>
                                    <behaviors:TapFeedbackBehavior />
                                </Border.Behaviors>
                                <Path Stroke="{StaticResource TealDark}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="20"
                                      HeightRequest="20"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      Data="M3,6 L17,6 M7,3 L7,9 M3,14 L17,14 M13,11 L13,17" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="9">
                            <Grid>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        IsVisible="{Binding IsNearestFilterSelected, Converter={StaticResource InvertBool}}">
                                    <Label Text="Nearest" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{StaticResource Teal}"
                                        Stroke="{StaticResource Teal}"
                                        IsVisible="{Binding IsNearestFilterSelected}">
                                    <Label Text="Nearest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                </Border>
                                <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Grid>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        IsVisible="{Binding IsTopRatedFilterSelected, Converter={StaticResource InvertBool}}">
                                    <Label Text="Top Rated" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{StaticResource Teal}"
                                        Stroke="{StaticResource Teal}"
                                        IsVisible="{Binding IsTopRatedFilterSelected}">
                                    <Label Text="Top Rated" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                </Border>
                                <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="toprated" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Grid>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        IsVisible="{Binding IsFastestFilterSelected, Converter={StaticResource InvertBool}}">
                                    <Label Text="Fastest" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{StaticResource Teal}"
                                        Stroke="{StaticResource Teal}"
                                        IsVisible="{Binding IsFastestFilterSelected}">
                                    <Label Text="Fastest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                </Border>
                                <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="fast" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Grid>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                        Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                        IsVisible="{Binding IsCheapestFilterSelected, Converter={StaticResource InvertBool}}">
                                    <Label Text="Cheapest" FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                        BackgroundColor="{StaticResource Teal}"
                                        Stroke="{StaticResource Teal}"
                                        IsVisible="{Binding IsCheapestFilterSelected}">
                                    <Label Text="Cheapest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                </Border>
                                <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="cheapest" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="38,82">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}"
                            WidthRequest="82"
                            HeightRequest="82"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 41">
                        <Label Text="⌕"
                               FontSize="34"
                               TextColor="{StaticResource TealDark}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding EmptyTitle}"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding EmptySubtitle}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:StoreListItemDto">
                    <Grid Padding="20,8">
                        <Grid.Behaviors>
                            <behaviors:TapFeedbackBehavior />
                        </Grid.Behaviors>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeShape="RoundRectangle 24">
                            <Grid RowDefinitions="132,Auto">
                                <Grid BackgroundColor="{StaticResource Teal}">
                                    <Label Text="{Binding NameInitial}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="46"
                                           TextColor="#BDF5E5"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Image Source="{Binding FullLogoUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasLogo}" />
                                    <Grid Margin="14" ColumnDefinitions="*,Auto" VerticalOptions="Start">
                                        <HorizontalStackLayout Spacing="6">
                                            <Border BackgroundColor="#33FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="9,4">
                                                <HorizontalStackLayout Spacing="5">
                                                    <Ellipse Fill="{StaticResource Success}" WidthRequest="7" HeightRequest="7" VerticalOptions="Center" />
                                                    <Label Text="{Binding OpenStatusText}" FontSize="11" TextColor="#DDFDF3" FontFamily="OpenSansSemibold" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border BackgroundColor="#29FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="9,4"
                                                    IsVisible="{Binding IsVerified}">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="✓" FontSize="10" TextColor="#DDFDF3" FontFamily="OpenSansSemibold" />
                                                    <Label Text="Verified" FontSize="11" TextColor="#DDFDF3" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Border BackgroundColor="#29FFFFFF" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="9,4"
                                                    IsVisible="{Binding IsTopRated}">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="★" FontSize="10" TextColor="#FFE08A" />
                                                    <Label Text="Top Rated" FontSize="11" TextColor="#DDFDF3" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Border Grid.Column="1"
                                                BackgroundColor="#0A5D50"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 16"
                                                Padding="10,5">
                                            <Label Text="{Binding RatingPillText}" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </Grid>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Padding="16,15,16,16" Spacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="17"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                        <Label Text="{Binding ReviewsAndPriceText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="⌖" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                            <Label Text="{Binding AreaDisplay}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="◷" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                            <Label Text="{Binding EstimatedTimeDisplay}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                            <Label Text="▱" FontSize="12" TextColor="{StaticResource Success}" />
                                            <Label Text="Pickup" FontSize="12" TextColor="{StaticResource Success}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="5">
                                            <Label Text="✓" FontSize="12" TextColor="{StaticResource Success}" />
                                            <Label Text="Delivery" FontSize="12" TextColor="{StaticResource Success}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding StartingAtText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{StaticResource Teal}"
                                                Stroke="Transparent"
                                                StrokeShape="RoundRectangle 18"
                                                Padding="17,9">
                                            <Border.Behaviors>
                                                <behaviors:TapFeedbackBehavior />
                                            </Border.Behaviors>
                                            <Label Text="View Store" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectStoreCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>

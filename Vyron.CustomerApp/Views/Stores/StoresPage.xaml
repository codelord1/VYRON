<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Stores.StoresPage"
             x:Name="ThisPage"
             x:DataType="vm:StoresViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding StoreItems}"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">
                    <Grid BackgroundColor="{StaticResource TealDark}" Padding="20,36,20,28" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Pickup at"
                                       FontSize="12"
                                       TextColor="#C9F4E6" />
                                <Label Text="Lekki Phase 1"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="White" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="#1F9678"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 21">
                                <Label Text="{Binding UserInitials}"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="0,24,0,20">
                            <Label Text="{Binding Greeting}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="White" />
                            <Label Text="Let's get your laundry sorted today."
                                   FontSize="15"
                                   TextColor="#E3FFF6" />
                        </VerticalStackLayout>

                        <Border Grid.Row="2"
                                BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="54">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="16,0">
                                <Label Text="Search"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray3}"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="Search laundry store or service"
                                       Text="{Binding SearchText}"
                                       ReturnCommand="{Binding SearchCommand}"
                                       ReturnType="Search" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                BackgroundColor="White"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 28"
                                Padding="18"
                                Margin="0,28,0,-68">
                            <Grid ColumnDefinitions="*,96" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="8">
                                    <Border BackgroundColor="{StaticResource Mint}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,5"
                                            HorizontalOptions="Start">
                                        <Label Text="Schedule today"
                                               FontSize="12"
                                               TextColor="{StaticResource TealDark}"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                    <Label Text="Schedule a laundry pickup today"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="20"
                                           TextColor="{StaticResource Gray5}" />
                                    <Label Text="Free pickup over N5,000. Pay on delivery."
                                           FontSize="13"
                                           TextColor="{StaticResource Gray3}" />
                                    <Border BackgroundColor="{StaticResource Teal}"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 20"
                                            Padding="16,9"
                                            HorizontalOptions="Start">
                                        <Label Text="Book Pickup"
                                               TextColor="White"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13" />
                                    </Border>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        WidthRequest="86"
                                        HeightRequest="86"
                                        BackgroundColor="{StaticResource Mint}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 28"
                                        VerticalOptions="Center">
                                    <Label Text="Truck"
                                           FontSize="12"
                                           TextColor="{StaticResource TealDark}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Padding="20,86,20,14" Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Quick services"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17" />
                            <Label Grid.Column="1"
                                   Text="See all"
                                   TextColor="{StaticResource TealDark}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="Wash" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Wash Only" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="W+I" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Wash &amp; Iron" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="Iron" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Iron Only" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="Dry" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Dry Clean" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="Bed" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Bedsheets" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12" HeightRequest="94">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="42" HeightRequest="42" Stroke="Transparent" StrokeShape="RoundRectangle 21">
                                        <Label Text="Suit" FontSize="11" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Suits" FontSize="12" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Nearby stores"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="Verified laundry stores near you"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray3}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="View all"
                                   TextColor="{StaticResource TealDark}"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}" StrokeShape="RoundRectangle 18" Padding="16,8">
                                    <Label Text="Nearest" FontSize="12" TextColor="White" FontFamily="OpenSansSemibold" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeShape="RoundRectangle 18" Padding="16,8">
                                    <Label Text="Top Rated" FontSize="12" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="toprated" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeShape="RoundRectangle 18" Padding="16,8">
                                    <Label Text="Fastest" FontSize="12" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="fast" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeShape="RoundRectangle 18" Padding="16,8">
                                    <Label Text="Verified" FontSize="12" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="verified" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="40,60">
                    <Border BackgroundColor="{StaticResource Mint}" WidthRequest="76" HeightRequest="76" Stroke="Transparent" StrokeShape="RoundRectangle 38">
                        <Label Text="Store" FontSize="13" TextColor="{StaticResource TealDark}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="No stores available yet"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <Label Text="New verified laundry partners will appear here."
                           FontSize="13"
                           TextColor="{StaticResource Gray3}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:StoreListItemDto">
                    <Grid Padding="20,8">
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardStroke}"
                                StrokeShape="RoundRectangle 24">
                            <Grid RowDefinitions="128,Auto">
                                <Grid Grid.Row="0" BackgroundColor="#10A37F">
                                    <Label Text="{Binding NameInitial}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="48"
                                           TextColor="#BDF5E5"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Image Source="{Binding FullLogoUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasLogo}" />
                                    <HorizontalStackLayout Margin="14" Spacing="8" VerticalOptions="Start">
                                        <Border BackgroundColor="#BDEEDB" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,4">
                                            <Label Text="{Binding OpenStatusText}" FontSize="11" TextColor="{StaticResource TealDark}" FontFamily="OpenSansSemibold" />
                                        </Border>
                                        <Border BackgroundColor="#BDEEDB" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="10,4" IsVisible="{Binding BadgeText, Converter={StaticResource NotEmptyBool}}">
                                            <Label Text="{Binding BadgeText}" FontSize="11" TextColor="{StaticResource TealDark}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Border BackgroundColor="#0A5D50" Stroke="Transparent" StrokeShape="RoundRectangle 16" Padding="10,5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,14,14,0">
                                        <Label Text="{Binding RatingDisplay}" TextColor="White" FontSize="12" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" Padding="16,14,16,16" Spacing="8">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding StartingFromText}" FontSize="12" TextColor="{StaticResource Gray3}" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Area}" FontSize="12" TextColor="{StaticResource Gray3}" />
                                        <Label Text="{Binding EstimatedTimeDisplay}" FontSize="12" TextColor="{StaticResource Gray3}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding PickupFeeDisplay}" FontSize="12" TextColor="{StaticResource TealDark}" />
                                        <Label Text="{Binding DeliveryFeeDisplay}" FontSize="12" TextColor="{StaticResource TealDark}" />
                                    </HorizontalStackLayout>
                                    <BoxView HeightRequest="1" Color="{StaticResource CardStroke}" Margin="0,2" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ServiceCountText}" FontSize="12" TextColor="{StaticResource Gray3}" VerticalOptions="Center" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource Teal}" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="16,9">
                                            <Label Text="View Store" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectStoreCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Vyron.CustomerApp.Behaviors"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             xmlns:dto="clr-namespace:Vyron.CustomerApp.DTOs"
             x:Class="Vyron.CustomerApp.Views.Stores.StoresPage"
             x:Name="ThisPage"
             x:DataType="vm:StoresViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <!-- Outer Grid so the loading overlay can layer on top of the RefreshView -->
    <Grid>

        <!-- ── Main scrollable content ──────────────────────────── -->
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     IsEnabled="{Binding IsNotNavigating}">
            <CollectionView ItemsSource="{Binding StoreItems}" SelectionMode="None">

                <!-- ── Header: title + error banner + search + filters ── -->
                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,18,20,16" Spacing="18">

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Nearby stores"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                            <Label Text="{Binding StoresSubtitle}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                        </VerticalStackLayout>

                        <!-- Error banner -->
                        <Border BackgroundColor="{AppThemeBinding Light=#FFF4F3, Dark=#381D1D}"
                                Stroke="{AppThemeBinding Light=#FFD4D1, Dark=#783838}"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,12"
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{AppThemeBinding Light=#C73535, Dark=#FFB4AD}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Try Again"
                                        Command="{Binding LoadCommand}"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        FontSize="12">
                                    <Button.Behaviors>
                                        <behaviors:TapFeedbackBehavior />
                                    </Button.Behaviors>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Search box -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                StrokeShape="RoundRectangle 26"
                                HeightRequest="62"
                                Padding="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="17,0">
                                <Path Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="20"
                                      HeightRequest="20"
                                      VerticalOptions="Center"
                                      Data="M9,16 C5.1,16 2,12.9 2,9 C2,5.1 5.1,2 9,2 C12.9,2 16,5.1 16,9 C16,12.9 12.9,16 9,16 Z M14,14 L19,19" />
                                <Entry Grid.Column="1"
                                       Placeholder="Search store, service, area"
                                       Text="{Binding SearchText}"
                                       ReturnCommand="{Binding SearchCommand}"
                                       ReturnType="Search"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       HeightRequest="44"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" />
                                <Border Grid.Column="2"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 21"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        VerticalOptions="Center">
                                    <Border.Behaviors>
                                        <behaviors:TapFeedbackBehavior />
                                    </Border.Behaviors>
                                    <Path Stroke="{StaticResource TealDark}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round"
                                          StrokeLineJoin="Round"
                                          WidthRequest="20"
                                          HeightRequest="20"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Data="M3,6 L17,6 M7,3 L7,9 M3,14 L17,14 M13,11 L13,17" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Filter pills -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="9">

                                <Grid>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                            IsVisible="{Binding IsNearestFilterSelected, Converter={StaticResource InvertBool}}">
                                        <Label Text="Nearest" FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}"
                                            IsVisible="{Binding IsNearestFilterSelected}">
                                        <Label Text="Nearest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                    </Border>
                                    <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <Grid>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                            IsVisible="{Binding IsTopRatedFilterSelected, Converter={StaticResource InvertBool}}">
                                        <Label Text="Top Rated" FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}"
                                            IsVisible="{Binding IsTopRatedFilterSelected}">
                                        <Label Text="Top Rated" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                    </Border>
                                    <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="toprated" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <Grid>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                            IsVisible="{Binding IsFastestFilterSelected, Converter={StaticResource InvertBool}}">
                                        <Label Text="Fastest" FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}"
                                            IsVisible="{Binding IsFastestFilterSelected}">
                                        <Label Text="Fastest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                    </Border>
                                    <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="fast" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <Grid>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                            IsVisible="{Binding IsCheapestFilterSelected, Converter={StaticResource InvertBool}}">
                                        <Label Text="Cheapest" FontSize="12" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 19" Padding="16,9"
                                            BackgroundColor="{StaticResource Teal}" Stroke="{StaticResource Teal}"
                                            IsVisible="{Binding IsCheapestFilterSelected}">
                                        <Label Text="Cheapest" FontSize="12" FontFamily="OpenSansSemibold" TextColor="White" />
                                    </Border>
                                    <Grid.Behaviors><behaviors:TapFeedbackBehavior /></Grid.Behaviors>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="cheapest" />
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- ── Empty state ───────────────────────────────────── -->
                <CollectionView.EmptyView>
                    <!-- IsNotBusy guard prevents the brief "no stores" flash during initial load -->
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="14"
                                         Padding="38,82"
                                         IsVisible="{Binding IsNotBusy}">
                        <!-- Mint/soft-teal circle hides the icon's white background
                             in dark mode (same pattern as OrdersPage empty state). -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Mint}, Dark={StaticResource DarkSoftTeal}}"
                                WidthRequest="82"
                                HeightRequest="82"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 41"
                                HorizontalOptions="Center">
                            <Image Source="vyron_icon_only.png"
                                   WidthRequest="46"
                                   HeightRequest="46"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding EmptyTitle}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptySubtitle}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               HorizontalTextAlignment="Center" />
                        <!-- Only shown when a search or filter is active -->
                        <Button Text="Clear Search"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchContext}"
                                HeightRequest="44"
                                CornerRadius="22"
                                FontSize="14"
                                Padding="28,0"
                                HorizontalOptions="Center"
                                Margin="0,4,0,0">
                            <Button.Behaviors>
                                <behaviors:TapFeedbackBehavior />
                            </Button.Behaviors>
                        </Button>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- ── Store cards ───────────────────────────────────── -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:StoreListItemDto">
                        <!-- TapFeedbackBehavior is intentionally NOT on this Grid.
                             TouchBehavior.ShouldMakeChildrenInputTransparent=true would make
                             the inner Order Now / View Store buttons input-transparent,
                             preventing their Commands from firing. The buttons carry their
                             own VSM press feedback via the global Button style. -->
                        <Grid Padding="20,8">

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkElevatedCardBackground}}"
                                    Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                                    StrokeShape="RoundRectangle 24">
                                <Grid RowDefinitions="132,Auto">

                                    <!-- ── Store banner (logo / initial + badges) ── -->
                                    <Grid BackgroundColor="{StaticResource Teal}">
                                        <Label Text="{Binding NameInitial}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="46"
                                               TextColor="#BDF5E5"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding FullLogoUrl}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasLogo}" />

                                        <Grid Margin="14" ColumnDefinitions="*,Auto" VerticalOptions="Start">
                                            <HorizontalStackLayout Spacing="6">

                                                <!-- Open — solid green -->
                                                <Border BackgroundColor="#16A34A"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 14"
                                                        Padding="9,4"
                                                        IsVisible="{Binding IsOpen}">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Ellipse Fill="White"
                                                                 Opacity="0.85"
                                                                 WidthRequest="6"
                                                                 HeightRequest="6"
                                                                 VerticalOptions="Center" />
                                                        <Label Text="Open"
                                                               FontSize="11"
                                                               TextColor="White"
                                                               FontFamily="OpenSansSemibold" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <!-- Closed — solid slate -->
                                                <Border BackgroundColor="#64748B"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 14"
                                                        Padding="9,4"
                                                        IsVisible="{Binding IsOpen, Converter={StaticResource InvertBool}}">
                                                    <Label Text="Closed"
                                                           FontSize="11"
                                                           TextColor="#CBD5E1"
                                                           FontFamily="OpenSansSemibold" />
                                                </Border>

                                                <!-- Verified — solid blue -->
                                                <Border BackgroundColor="#0284C7"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 14"
                                                        Padding="9,4"
                                                        IsVisible="{Binding IsVerified}">
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="✓"
                                                               FontSize="10"
                                                               TextColor="White"
                                                               FontFamily="OpenSansSemibold" />
                                                        <Label Text="Verified"
                                                               FontSize="11"
                                                               TextColor="White" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <!-- Top Rated — solid amber -->
                                                <Border BackgroundColor="#D97706"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 14"
                                                        Padding="9,4"
                                                        IsVisible="{Binding IsTopRated}">
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="★"
                                                               FontSize="10"
                                                               TextColor="White" />
                                                        <Label Text="Top Rated"
                                                               FontSize="11"
                                                               TextColor="White" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                            </HorizontalStackLayout>

                                            <!-- Rating pill — solid dark -->
                                            <Border Grid.Column="1"
                                                    BackgroundColor="#1E293B"
                                                    Stroke="Transparent"
                                                    StrokeShape="RoundRectangle 16"
                                                    Padding="10,5">
                                                <Label Text="{Binding RatingPillText}"
                                                       TextColor="White"
                                                       FontSize="12"
                                                       FontFamily="OpenSansSemibold" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- ── Card body ───────────────────────────── -->
                                    <VerticalStackLayout Grid.Row="1" Padding="16,15,16,16" Spacing="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                                            <Label Text="{Binding ReviewsAndPriceText}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="⌖" FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                                <Label Text="{Binding AreaDisplay}" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                                <Label Text="◷" FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />
                                                <Label Text="{Binding EstimatedTimeDisplay}" FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                                <Label Text="▱" FontSize="12" TextColor="{StaticResource Success}" />
                                                <Label Text="Pickup" FontSize="12" TextColor="{StaticResource Success}" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="3" Spacing="5">
                                                <Label Text="✓" FontSize="12" TextColor="{StaticResource Success}" />
                                                <Label Text="Delivery" FontSize="12" TextColor="{StaticResource Success}" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1"
                                                 Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />

                                        <!-- Footer: starting price · Order Now · View Store -->
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding StartingAtText}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                                   VerticalOptions="Center" />

                                            <!-- Order Now navigates directly to ServiceSelection -->
                                            <Button Grid.Column="1"
                                                    Text="Order Now"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OrderNowCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#1E293B"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    Padding="14,0" />

                                            <!-- View Store navigates to StoreDetails -->
                                            <Button Grid.Column="2"
                                                    Text="View Store"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectStoreCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource Teal}"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    Padding="14,0" />
                                        </Grid>
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>

                            <!-- Card tap → View Store (same route as View Store button).
                                 Buttons inside consume their own tap, so the card tap only
                                 fires when the user taps outside the two buttons. -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectStoreCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

        <!-- ── Loading / navigation overlay ────────────────────────
             Blocks all input while IsBusy (API call) or IsNavigating
             (Shell route transition). The LoadingIcon image is spun
             programmatically from StoresPage.xaml.cs.              -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="{Binding IsOverlayVisible}"
              InputTransparent="False"
              BackgroundColor="{AppThemeBinding Light=#EEF8FAFC, Dark=#EE061B1A}">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <!-- Circle clips the icon's white background in dark mode.
                     Image diagonal at 44px = ~62px; circle at 72px keeps
                     all corners inside the clip at every rotation angle. -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}"
                        WidthRequest="72"
                        HeightRequest="72"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 36"
                        HorizontalOptions="Center">
                    <Image x:Name="LoadingIcon"
                           Source="vyron_icon_only.png"
                           WidthRequest="44"
                           HeightRequest="44"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding OverlayText}"
                       FontSize="14"
                       FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>

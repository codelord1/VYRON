<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.CustomerApp.ViewModels"
             x:Class="Vyron.CustomerApp.Views.Disputes.RaiseDisputePage"
             x:DataType="vm:RaiseDisputeViewModel"
             Title="Raise Dispute"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground}, Dark={StaticResource DarkPageBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Success -->
            <VerticalStackLayout IsVisible="{Binding Submitted}" Spacing="16">
                <Label Text="✅" FontSize="56" HorizontalOptions="Center" />
                <Label Text="Dispute Submitted"
                       FontFamily="OpenSansSemibold" FontSize="22"
                       HorizontalOptions="Center" />
                <Label Text="{Binding SuccessMessage}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Text="← Back" Command="{Binding GoBackCommand}" />
            </VerticalStackLayout>

            <!-- Form -->
            <VerticalStackLayout IsVisible="{Binding Submitted, Converter={StaticResource InvertBool}}"
                                 Spacing="16">

                <Label Text="What's the issue?"
                       FontFamily="OpenSansSemibold" FontSize="18" />
                <Label Text="We take every complaint seriously. Please describe the issue and we'll resolve it as soon as possible."
                       FontSize="13" TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" />

                <Border BackgroundColor="#FFF1F0" Stroke="#FFB8B0"
                        StrokeShape="RoundRectangle 10" Padding="12,10"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullToBool}}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" FontSize="13" />
                </Border>

                <Label Text="Dispute Type" FontFamily="OpenSansSemibold" FontSize="14" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                        StrokeShape="RoundRectangle 12" Padding="0">
                    <Picker ItemsSource="{Binding DisputeTypes}"
                            SelectedItem="{Binding SelectedType}"
                            BackgroundColor="Transparent" Margin="12,0" />
                </Border>

                <Label Text="Describe the Issue *" FontFamily="OpenSansSemibold" FontSize="14" />
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource LightCardBackground}, Dark={StaticResource DarkCardBackground}}" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeShape="RoundRectangle 12">
                    <Editor Placeholder="Please describe what happened in detail..."
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="120"
                            BackgroundColor="Transparent"
                            Margin="12,8" />
                </Border>

                <Button Text="Submit Dispute"
                        Command="{Binding SubmitCommand}"
                        BackgroundColor="#C0392B"
                        IsEnabled="{Binding IsNotBusy}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Teal}"
                                   IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

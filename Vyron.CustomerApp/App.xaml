<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Vyron.CustomerApp.Helpers"
             x:Class="Vyron.CustomerApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Brand Colours ── -->
            <Color x:Key="VyronPrimary">#006B50</Color>
            <Color x:Key="VyronBlack">#111111</Color>
            <AppThemeBinding x:Key="VyronBackground" Light="#F7F8FA" Dark="#071416" />
            <AppThemeBinding x:Key="VyronWhite" Light="#FFFFFF" Dark="#102022" />
            <AppThemeBinding x:Key="VyronText" Light="#1F2937" Dark="#F4FAF7" />
            <Color x:Key="VyronAccent">#008866</Color>
            <Color x:Key="VyronSuccess">#16A34A</Color>
            <Color x:Key="VyronWarning">#F59E0B</Color>
            <Color x:Key="VyronError">#DC2626</Color>
            
            <Color x:Key="Teal">#008866</Color>
            <Color x:Key="TealDark">#006B50</Color>
            <AppThemeBinding x:Key="Mint" Light="#D9F8EC" Dark="#143B35" />
            <AppThemeBinding x:Key="MintSoft" Light="#EEF8F4" Dark="#0E2424" />
            <AppThemeBinding x:Key="Dark" Light="#061F1A" Dark="#102527" />
            <AppThemeBinding x:Key="Bg" Light="#F4FAF7" Dark="#071416" />
            <AppThemeBinding x:Key="CardStroke" Light="#DCE9E4" Dark="#263A3C" />
            <AppThemeBinding x:Key="Gray3" Light="#697780" Dark="#9AA8AC" />
            <AppThemeBinding x:Key="Gray5" Light="#071A1F" Dark="#F4FAF7" />
            <Color x:Key="Danger">#DC2626</Color>

            <Color x:Key="Success">#16A34A</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <AppThemeBinding x:Key="InputBg" Light="#FFFFFF" Dark="#102022" />
            <Color x:Key="OverlayBg">#99000000</Color>

            <!-- ── Converters (global) ── -->
            <conv:NotNullToBoolConverter   x:Key="NotNullToBool" />
            <conv:NullToBoolConverter      x:Key="NullToBool" />
            <conv:InvertBoolConverter      x:Key="InvertBool" />
            <conv:NotEmptyBoolConverter    x:Key="NotEmptyBool" />
            <conv:InitialsConverter        x:Key="InitialsConverter" />

            <!-- ── Global Styles ── -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource Gray5}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="BackgroundColor" Value="{DynamicResource Teal}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.97" />
                                    <Setter Property="Opacity" Value="0.86" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.58" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="TextColor" Value="{DynamicResource Gray5}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource Gray3}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="{DynamicResource InputBg}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{DynamicResource Gray5}" />
            </Style>

            <Style TargetType="CollectionView">
                <Setter Property="SelectionMode" Value="None" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="SelectionMode" Value="None" />
                <Setter Property="SeparatorColor" Value="{DynamicResource CardStroke}" />
            </Style>

            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Bg}" />
                <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Gray5}" />
                <Setter Property="Shell.TitleColor" Value="{DynamicResource Gray5}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource InputBg}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource Teal}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource Gray3}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource Teal}" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource InputBg}" />
                <Setter Property="Stroke" Value="{DynamicResource CardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Padding" Value="18" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Vyron.CustomerApp.Helpers"
             x:Class="Vyron.CustomerApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Brand Colours ── -->
            <Color x:Key="Teal">#008866</Color>
            <Color x:Key="TealDark">#006B50</Color>
            <Color x:Key="Mint">#D9F8EC</Color>
            <Color x:Key="MintSoft">#EEF8F4</Color>
            <Color x:Key="Dark">#061F1A</Color>
            <Color x:Key="Bg">#F4FAF7</Color>
            <Color x:Key="CardStroke">#DCE9E4</Color>
            <Color x:Key="Gray3">#697780</Color>
            <Color x:Key="Gray5">#071A1F</Color>
            <Color x:Key="Danger">#F04452</Color>

            <!-- ── Converters (global) ── -->
            <conv:NotNullToBoolConverter   x:Key="NotNullToBool" />
            <conv:NullToBoolConverter      x:Key="NullToBool" />
            <conv:InvertBoolConverter      x:Key="InvertBool" />
            <conv:NotEmptyBoolConverter    x:Key="NotEmptyBool" />
            <conv:InitialsConverter        x:Key="InitialsConverter" />

            <!-- ── Global Styles ── -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gray5}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="BackgroundColor" Value="{StaticResource Teal}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="1" />
                                    <Setter Property="Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.97" />
                                    <Setter Property="Opacity" Value="0.86" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.58" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="TextColor" Value="{StaticResource Gray5}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Gray3}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{StaticResource Gray5}" />
            </Style>

            <Style TargetType="CollectionView">
                <Setter Property="SelectionMode" Value="None" />
            </Style>

            <Style TargetType="ListView">
                <Setter Property="SelectionMode" Value="None" />
                <Setter Property="SeparatorColor" Value="{StaticResource CardStroke}" />
            </Style>

            <Style TargetType="Shell" ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor" Value="{StaticResource Bg}" />
                <Setter Property="Shell.ForegroundColor" Value="{StaticResource Gray5}" />
                <Setter Property="Shell.TitleColor" Value="{StaticResource Gray5}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="White" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Teal}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray3}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Teal}" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Padding" Value="18" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

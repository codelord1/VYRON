<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vyron.DriverApp.Views.MainPage"
             BackgroundColor="#001815">
    <Grid Padding="30,34" RowDefinitions="Auto,*,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="9:41" TextColor="White" FontFamily="OpenSansSemibold" />
            <Label Grid.Column="1" Text="◔ ︴" TextColor="#B8D7D1" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="18">
            <Border WidthRequest="72" HeightRequest="72" Stroke="Transparent" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource RiderPrimary}">
                <Label Text="V" TextColor="White" FontFamily="OpenSansSemibold" FontSize="38" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Spacing="3">
                <Label Text="vyron" TextColor="White" FontFamily="OpenSansSemibold" FontSize="34" HorizontalOptions="Center" />
                <Label Text="RIDER" CharacterSpacing="2" TextColor="#9EC7BE" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="7" Margin="0,0,0,20">
            <Ellipse WidthRequest="6" HeightRequest="6" Fill="#7C9892" />
            <Ellipse WidthRequest="6" HeightRequest="6" Fill="#B8D7D1" />
            <Ellipse WidthRequest="6" HeightRequest="6" Fill="#7C9892" />
        </HorizontalStackLayout>
        <VerticalStackLayout Grid.Row="3" Spacing="12">
            <Button Text="Continue" Clicked="OnContinueClicked" />
            <Label Text="POWERED BY VYRON" TextColor="#8EB6AD" CharacterSpacing="1.4" FontSize="11" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

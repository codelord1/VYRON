<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vyron.DriverApp.ViewModels"
             xmlns:model="clr-namespace:Vyron.DriverApp.Models"
             x:Class="Vyron.DriverApp.Views.RiderNotificationsPage"
             x:DataType="vm:NotificationsViewModel">
    <Grid RowDefinitions="Auto,*" Padding="22,24,22,12" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border WidthRequest="38" HeightRequest="38" Stroke="Transparent" StrokeShape="RoundRectangle 19" BackgroundColor="{AppThemeBinding Light={StaticResource RiderSoft}, Dark={StaticResource RiderCardDark}}">
                <Label Text="←" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBackCommand}" /></Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="Notifications" Style="{StaticResource RiderTitle}" FontSize="20" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="Mark all read" Style="{StaticResource RiderMutedLabel}" FontFamily="OpenSansSemibold" VerticalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding MarkAllReadCommand}" /></Label.GestureRecognizers>
            </Label>
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:RiderNotification">
                    <Border Style="{StaticResource RiderCard}" Margin="0,0,0,8" Padding="14">
                        <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                            <Border WidthRequest="38" HeightRequest="38" Stroke="Transparent" StrokeShape="RoundRectangle 19" BackgroundColor="{AppThemeBinding Light={StaticResource RiderSoft}, Dark={StaticResource RiderInputDark}}">
                                <Label Text="{Binding Icon}" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Message}" Style="{StaticResource RiderMutedLabel}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                                <Label Text="{Binding Time}" Style="{StaticResource RiderMutedLabel}" FontSize="11" HorizontalOptions="End" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource RiderPrimary}" HorizontalOptions="End" IsVisible="{Binding IsUnread}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

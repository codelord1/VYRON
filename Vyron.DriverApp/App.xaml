<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vyron.DriverApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Teal">#00C9A7</Color>
            <Color x:Key="TealDark">#007A58</Color>
            <Color x:Key="Dark">#0A0A0A</Color>
            <Color x:Key="Bg">#F4F4F0</Color>
            <Color x:Key="Gray3">#B0AFA8</Color>
            <Color x:Key="Gray5">#2C2C2A</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gray5}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="BackgroundColor" Value="{StaticResource Teal}" />
                <Setter Property="TextColor" Value="{StaticResource Dark}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
